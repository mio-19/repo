--- a/private/google-modules/display/common/include/ea_panel.h	1970-01-01 10:00:00.000000000 +1000
+++ b/private/google-modules/display/common/include/ea_panel.h	2026-11-08 16:20:12.035554821 +1100
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * ea_panel.h - Exposure adjustment API for OLED panels
+ *
+ * Copyright (C) 2024, Hamster Tian <haotia@gmail.com>
+ *
+ * This function intercepts panel brightness requests below the PWM threshold
+ * and instead applies a DPP linear matrix scale so the hardware PWM frequency
+ * stays in the high-frequency range.
+ */
+
+#ifndef EA_PANEL_H
+#define EA_PANEL_H
+
+/**
+ * ea_panel_calc_backlight - adjust backlight to avoid low-freq PWM
+ * @bl_lvl: requested brightness level
+ *
+ * Returns the brightness value to send to the panel hardware. When @bl_lvl is
+ * below the threshold a DPP linear matrix override is engaged and the threshold
+ * value is returned instead.  When @bl_lvl is at or above the threshold any
+ * previous override is cleared and @bl_lvl is returned unchanged.
+ */
+unsigned int ea_panel_calc_backlight(unsigned int bl_lvl);
+
+#endif /* EA_PANEL_H */
