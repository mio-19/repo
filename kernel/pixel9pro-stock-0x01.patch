diff -ruN a/private/google-modules/display/panels/caimito/panel-gs-cm4.c b/private/google-modules/display/panels/caimito/panel-gs-cm4.c
--- a/private/google-modules/display/panels/caimito/panel-gs-cm4.c	2026-11-08 22:30:49.679889676 +1100
+++ b/private/google-modules/display/panels/caimito/panel-gs-cm4.c	2026-11-08 22:44:49.404608529 +1100
@@ -728,11 +728,28 @@
 }
 
 
+/*
+ * First PWM experiment: change only the byte written by the stock driver.
+ * The low-bit PWM interpretation is unverified on CM4/KM4. Start with 0;
+ * -1 preserves stock behavior and is restored whenever the module loads.
+ * Candidate 0 is motivated by Hamster Tian (updateing)'s HK3 experiment:
+ * https://github.com/updateing/android_kernel_google_zuma/commit/759e096a6ba39687e0ebe20cf5845ecf69632868
+ * That GPL-2.0 experiment used a complete four-byte payload; it does not
+ * establish the meaning or effect of this single byte on Pixel 9.
+ */
+static int pwm_mode = -1;
+module_param(pwm_mode, int, 0644);
+
 static void cm4_set_panel_feat_early_exit(struct gs_panel *ctx, unsigned long *feat, u32 vrefresh)
 {
 	struct device *dev = ctx->dev;
 	struct cm4_panel *spanel = to_spanel(ctx);
 	u8 val = (test_bit(FEAT_EARLY_EXIT, feat) && vrefresh != 80) ? 0x01 : 0x81;
+	int mode = READ_ONCE(pwm_mode);
+
+	/* Invalid values retain stock behavior; only bits 0-2 are experimental. */
+	if (mode >= 0 && mode <= 7)
+		val = (val & 0x80) | mode;
 
 	GS_DCS_BUF_ADD_CMD(dev, 0xB0, 0x00, 0x01, 0xBD);
 	GS_DCS_BUF_ADD_CMD(dev, 0xBD, val);
