+/* We cannot commit changes from from panel driver so we have to keep the
+ * matrices as global variab/s.
+ */
+static struct exynos_matrix linear_matrix_override;
+static int linear_matrix_override_enabled;
+
+/* Brightness level below which we engage the DPP matrix override instead of
+ * sending a low brightness value to the panel (to avoid low-freq PWM).
+ */
+static int linear_matrix_application_threshold = 1400;
+module_param(linear_matrix_application_threshold, int, 0644);
+
+/**
+ * ea_panel_calc_backlight - intercept brightness to prevent low-freq PWM
+ *
+ * When @bl_lvl is below the threshold, engage the DPP linear matrix override
+ * and return the threshold brightness to the panel so the hardware PWM stays
+ * in the high-frequency range.  When at or above threshold, clear any override.
+ */
+unsigned int ea_panel_calc_backlight(unsigned int bl_lvl)
+{
+	struct exynos_matrix matrix;
+	__u16 coef;
+	int i;
+
+	if (linear_matrix_application_threshold == 0)
+		linear_matrix_application_threshold = 1;
+
+	if (bl_lvl != 0 && bl_lvl < (unsigned int)linear_matrix_application_threshold) {
+		/* Scale down via DPP matrix; keep hardware PWM freq high. */
+		coef = (__u16)((__u32)bl_lvl * LINEAR_MATRIX_OVERRIDE_SCALE_FACTOR /
+			       (unsigned int)linear_matrix_application_threshold);
+		for (i = 0; i < (int)ARRAY_SIZE(matrix.coeffs); i++)
+			matrix.coeffs[i] = coef;
+		for (i = 0; i < (int)ARRAY_SIZE(matrix.offsets); i++)
+			matrix.offsets[i] = LINEAR_MATRIX_OVERRIDE_SCALE_FACTOR;
+
+		memcpy(&linear_matrix_override, &matrix, sizeof(matrix));
+		linear_matrix_override_enabled = 1;
+		return (unsigned int)linear_matrix_application_threshold;
+	}
+
+	/* Clear any previous override */
+	linear_matrix_override_enabled = 0;
+	return bl_lvl;
+}
+EXPORT_SYMBOL(ea_panel_calc_backlight);
+
+static void exynos_drm_crtc_apply_linear_matrix_override(const struct exynos_matrix *original,
+							 const struct exynos_matrix *override,
+							 struct exynos_matrix *output)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(output->coeffs); i++)
+		output->coeffs[i] = (uint32_t)original->coeffs[i] * override->coeffs[i] /
+				    LINEAR_MATRIX_OVERRIDE_SCALE_FACTOR;
+
+	for (i = 0; i < ARRAY_SIZE(output->offsets); i++)
+		output->offsets[i] = (uint32_t)original->offsets[i] * override->offsets[i] /
+				     LINEAR_MATRIX_OVERRIDE_SCALE_FACTOR;
+}
+
+static struct exynos_matrix *exynos_drm_crtc_get_linear_matrix(struct drm_crtc_state *state)
+{
+	struct exynos_drm_crtc_state *exynos_state;
+	const struct exynos_matrix *original, *override;
+	struct exynos_matrix *output;
+	static const struct exynos_matrix default_matrix = {
+		.coeffs = {
+			0x1fff, 0, 0, // 0x1fff is 100% in DQE terms
+			0, 0x1fff, 0,
+			0, 0, 0x1fff
+		},
+		.offsets = {
+			0,
+			0,
+			0
+		}
+	};
+
+	exynos_state = to_exynos_crtc_state(state);
+
+	if (exynos_state->linear_matrix) {
+		original = exynos_state->linear_matrix->data;
+	} else {
+		original = NULL;
+	}
+
+	if (!linear_matrix_override_enabled) {
+		output = (struct exynos_matrix *) original;
+		goto exit;
+	}
+
+	override = &linear_matrix_override;
+
+	/* We need a base matrix to apply override on, load our default matrix here */
+	if (!original)
+		original = &default_matrix;
+
+	output = &exynos_state->linear_matrix_cache;
+
+	exynos_drm_crtc_apply_linear_matrix_override(original, override, output);
+
+exit:
+	return output;
+}
+
