# Android userspace requirements on the Nura SM6350/SM7225 kernel.
# Linux configuration symbols; Linux kernel project, GPL-2.0-only:
# https://github.com/sm6350-mainline/linux/tree/v7.2.0-sm6350
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY="selinux"
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_FS_ENCRYPTION=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_AUDIT=y
CONFIG_KEYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=y
# Keep storage, display and remoteproc drivers available before modules load.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_INTERCONNECT_QCOM_SM6350=y
CONFIG_PINCTRL_SM6350=y
CONFIG_SM_DISPCC_6350=y
CONFIG_SM_GCC_6350=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
