+    /**
+     * Ring or silence the phone when the watch writes the find-phone characteristic.
+     * @param value one byte, 1 to start and 0 to stop
+     */
+    private void handleFindPhone(byte[] value) {
+        if (value == null || value.length < 1) {
+            return;
+        }
+        final GBDeviceEventFindPhone findPhoneEvent = new GBDeviceEventFindPhone();
+        switch (value[0] & 0xff) {
+            case 1:
+                findPhoneEvent.event = GBDeviceEventFindPhone.Event.START;
+                break;
+            case 0:
+                findPhoneEvent.event = GBDeviceEventFindPhone.Event.STOP;
+                break;
+            default:
+                LOG.warn("Unknown find phone value: {}", value[0] & 0xff);
+                return;
+        }
+        evaluateGBDeviceEvent(findPhoneEvent);
+    }
 
