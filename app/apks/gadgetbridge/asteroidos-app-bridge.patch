+
+    /*
+     * App Bridge: relays smartwatch remote actions (camera remote, phone text input).
+     */
+    private static final String APP_BRIDGE_PERMISSION =
+            "nodomain.freeyourgadget.gadgetbridge.permission.APP_BRIDGE";
+    private static final String ACTION_SEND_TO_WATCH =
+            "nodomain.freeyourgadget.gadgetbridge.ACTION_SEND_TO_WATCH";
+    private static final String ACTION_RECEIVE_FROM_WATCH =
+            "nodomain.freeyourgadget.gadgetbridge.ACTION_RECEIVE_FROM_WATCH";
+    private static final String CAMERA_PACKAGE = "app.grapheneos.camera";
+    private static final String CAMERA_APP_ID = "org.asteroidos.camera";
+    private static final String CAMERA_WIRE_APP_ID = "cam";
+    private static final String KEYBOARD_APP_ID = "org.asteroidos.keyboard";
+    private static final String KEYBOARD_WIRE_APP_ID = "kbd";
+    private static final int KEYBOARD_NOTIFICATION_ID = 0xA072;
+    private static final String KEYBOARD_CHANNEL_ID = "asteroidos_keyboard_channel";
+    private static final String ACTION_KEYBOARD_REPLY =
+            "nodomain.freeyourgadget.gadgetbridge.KEYBOARD_INPUT_REPLY";
+    private static final String EXTRA_KEYBOARD_TEXT = "extra_keyboard_text";
+    private static final int APP_BRIDGE_MAX_PACKET = 512;
+    private static final Set<String> WATCH_TO_PHONE_ACTIONS = new HashSet<>(Arrays.asList(
+            "capture", "flip", "zoom_in", "zoom_out", "torch", "mode_photo", "mode_video",
+            "status_query"));
+    private static final Set<String> PHONE_TO_WATCH_ACTIONS = new HashSet<>(Arrays.asList(
+            "ready", "paused", "photo_captured", "video_started", "video_stopped"));
+
+    private BroadcastReceiver appBridgeReceiver = null;
+    private BroadcastReceiver keyboardReplyReceiver = null;
+
+    private void registerAppBridgeReceiver() {
+        if (appBridgeReceiver != null) return;
+        final Context context = GBApplication.getContext();
+        appBridgeReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context ctx, Intent intent) {
+                handleSendToWatchIntent(intent, this);
+            }
+        };
+        ContextCompat.registerReceiver(
+                context,
+                appBridgeReceiver,
+                new IntentFilter(ACTION_SEND_TO_WATCH),
+                APP_BRIDGE_PERMISSION,
+                null,
+                ContextCompat.RECEIVER_EXPORTED
+        );
+    }
+
+    private void registerKeyboardReplyReceiver() {
+        if (keyboardReplyReceiver != null) return;
+        final Context context = GBApplication.getContext();
+        keyboardReplyReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context ctx, Intent intent) {
+                if (intent == null || !ACTION_KEYBOARD_REPLY.equals(intent.getAction())) return;
+                Bundle results = RemoteInput.getResultsFromIntent(intent);
+                if (results != null) {
+                    CharSequence text = results.getCharSequence(EXTRA_KEYBOARD_TEXT);
+                    if (text != null && text.length() > 0) {
+                        sendAppBridgeMessage(KEYBOARD_WIRE_APP_ID, "commit", text.toString());
+                    }
+                }
+                cancelKeyboardInputNotification();
+            }
+        };
+        IntentFilter filter = new IntentFilter(ACTION_KEYBOARD_REPLY);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            context.registerReceiver(keyboardReplyReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        } else {
+            context.registerReceiver(keyboardReplyReceiver, filter);
+        }
+    }
+
+    @Override
+    public void dispose() {
+        super.dispose();
+        final Context context = GBApplication.getContext();
+        if (appBridgeReceiver != null) {
+            try {
+                context.unregisterReceiver(appBridgeReceiver);
+            } catch (IllegalArgumentException e) {
+                LOG.warn("Failed to unregister appBridgeReceiver", e);
+            }
+            appBridgeReceiver = null;
+        }
+        if (keyboardReplyReceiver != null) {
+            try {
+                context.unregisterReceiver(keyboardReplyReceiver);
+            } catch (IllegalArgumentException e) {
+                LOG.warn("Failed to unregister keyboardReplyReceiver", e);
+            }
+            keyboardReplyReceiver = null;
+        }
+        cancelKeyboardInputNotification();
+    }
+
+    private boolean isSentFromCameraApp(final BroadcastReceiver receiver) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false;
+        final int sentFromUid = receiver.getSentFromUid();
+        if (sentFromUid == Process.INVALID_UID) return false;
+        try {
+            return getContext().getPackageManager().getPackageUid(CAMERA_PACKAGE, 0) == sentFromUid;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    private void showKeyboardInputNotification(String prompt) {
+        final Context context = GBApplication.getContext();
+        final NotificationManager nm = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm == null) return;
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationChannel channel = new NotificationChannel(
+                    KEYBOARD_CHANNEL_ID,
+                    "Smartwatch Keyboard",
+                    NotificationManager.IMPORTANCE_HIGH
+            );
+            channel.setDescription("Direct text input for smartwatch keyboard");
+            nm.createNotificationChannel(channel);
+        }
+
+        RemoteInput remoteInput = new RemoteInput.Builder(EXTRA_KEYBOARD_TEXT)
+                .setLabel("Type on phone...")
+                .build();
+
+        Intent replyIntent = new Intent(ACTION_KEYBOARD_REPLY).setPackage(context.getPackageName());
+        int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            flags |= PendingIntent.FLAG_MUTABLE;
+        }
+        PendingIntent replyPendingIntent = PendingIntent.getBroadcast(context, 0, replyIntent, flags);
+
+        NotificationCompat.Action replyAction =
+                new NotificationCompat.Action.Builder(
+                        android.R.drawable.ic_menu_send,
+                        "Send to Watch",
+                        replyPendingIntent
+                )
+                .addRemoteInput(remoteInput)
+                .build();
+
+        int icon = context.getApplicationInfo().icon != 0 ? context.getApplicationInfo().icon : android.R.drawable.ic_input_add;
+        String content = (prompt != null && !prompt.isEmpty()) ? prompt : "Enter text on phone to send to watch";
+
+        Notification notification = new NotificationCompat.Builder(context, KEYBOARD_CHANNEL_ID)
+                .setSmallIcon(icon)
+                .setContentTitle("Smartwatch Text Input")
+                .setContentText(content)
+                .setPriority(NotificationCompat.PRIORITY_HIGH)
+                .setDefaults(Notification.DEFAULT_ALL)
+                .setAutoCancel(true)
+                .addAction(replyAction)
+                .build();
+
+        nm.notify(KEYBOARD_NOTIFICATION_ID, notification);
+    }
+
+    private void cancelKeyboardInputNotification() {
+        final Context context = GBApplication.getContext();
+        final NotificationManager nm = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (nm != null) {
+            nm.cancel(KEYBOARD_NOTIFICATION_ID);
+        }
+    }
+
+    private void handleSendToWatchIntent(Intent intent, BroadcastReceiver receiver) {
+        if (intent == null || !ACTION_SEND_TO_WATCH.equals(intent.getAction())) return;
+        final String appId = intent.getStringExtra("extra_app_id");
+        final String action = intent.getStringExtra("extra_action");
+        final String payload = intent.getStringExtra("extra_payload");
+
+        if (KEYBOARD_APP_ID.equals(appId)) {
+            if (action != null && getDevice().isInitialized()) {
+                sendAppBridgeMessage(KEYBOARD_WIRE_APP_ID, action, payload);
+            }
+            return;
+        }
+
+        if (!CAMERA_APP_ID.equals(appId)) return;
+        if (!isSentFromCameraApp(receiver)) {
+            LOG.warn("AppBridge: dropping message not sent by {}", CAMERA_PACKAGE);
+            return;
+        }
+        if (action == null || !PHONE_TO_WATCH_ACTIONS.contains(action)) return;
+        if (!getDevice().isInitialized()) return;
+        sendAppBridgeMessage(CAMERA_WIRE_APP_ID, action, payload);
+    }
+
+    /**
+     * Process incoming App Bridge frame from AsteroidOS.
+     * Format: [0xA0][appIdLen:1B][appId][actionLen:1B][action][payload]
+     */
+    private void handleAppBridgeData(byte[] value) {
+        if (value == null || value.length < 3 || value.length > APP_BRIDGE_MAX_PACKET) {
+            return;
+        }
+        if ((value[0] & 0xFF) != 0xA0) {
+            LOG.warn("AppBridge: invalid magic byte 0x{}", Integer.toHexString(value[0] & 0xFF));
+            return;
+        }
+        int offset = 1;
+        final int appIdLen = value[offset++] & 0xFF;
+        if (value.length < offset + appIdLen + 1) return;
+        final String appId = new String(value, offset, appIdLen, StandardCharsets.UTF_8);
+        offset += appIdLen;
+
+        final int actionLen = value[offset++] & 0xFF;
+        if (value.length < offset + actionLen) return;
+        final String action = new String(value, offset, actionLen, StandardCharsets.UTF_8);
+        offset += actionLen;
+
+        String payload = "";
+        if (value.length > offset) {
+            payload = new String(value, offset, value.length - offset, StandardCharsets.UTF_8);
+        }
+
+        if (KEYBOARD_WIRE_APP_ID.equals(appId)) {
+            if ("request_input".equals(action) || "open".equals(action)) {
+                showKeyboardInputNotification(payload);
+            } else if ("close".equals(action)) {
+                cancelKeyboardInputNotification();
+            }
+            return;
+        }
+
+        if (!CAMERA_WIRE_APP_ID.equals(appId) || !WATCH_TO_PHONE_ACTIONS.contains(action)) {
+            LOG.debug("AppBridge: ignoring frame for unsupported app or action");
+            return;
+        }
+
+        final Intent broadcast = new Intent(ACTION_RECEIVE_FROM_WATCH)
+                .setPackage(CAMERA_PACKAGE)
+                .putExtra("extra_app_id", CAMERA_APP_ID)
+                .putExtra("extra_action", action)
+                .putExtra("extra_payload", payload);
+        getContext().sendBroadcast(broadcast, APP_BRIDGE_PERMISSION);
+    }
+
+    private void sendAppBridgeMessage(String wireAppId, String action) {
+        sendAppBridgeMessage(wireAppId, action, null);
+    }
+
+    private void sendAppBridgeMessage(String wireAppId, String action, String payload) {
+        final byte[] appIdBytes = wireAppId.getBytes(StandardCharsets.UTF_8);
+        final byte[] actionBytes = action.getBytes(StandardCharsets.UTF_8);
+        final byte[] payloadBytes = payload != null ? payload.getBytes(StandardCharsets.UTF_8) : new byte[0];
+        final byte[] packet = new byte[3 + appIdBytes.length + actionBytes.length + payloadBytes.length];
+        int idx = 0;
+        packet[idx++] = (byte) 0xA0;
+        packet[idx++] = (byte) appIdBytes.length;
+        System.arraycopy(appIdBytes, 0, packet, idx, appIdBytes.length);
+        idx += appIdBytes.length;
+        packet[idx++] = (byte) actionBytes.length;
+        System.arraycopy(actionBytes, 0, packet, idx, actionBytes.length);
+        idx += actionBytes.length;
+        if (payloadBytes.length > 0) {
+            System.arraycopy(payloadBytes, 0, packet, idx, payloadBytes.length);
+        }
+
+        final TransactionBuilder builder = createTransactionBuilder("sendAppBridgeMessage");
+        safeWriteToCharacteristic(builder, AsteroidOSConstants.APP_BRIDGE_RX_CHAR, packet);
+        builder.queue();
+    }
