+
+    /*
+     * App Bridge: relays a smartwatch camera remote to the GrapheneOS Camera app.
+     *
+     * Threat model: other apps on the phone must neither read what the watch sends nor be able to
+     * make the watch act. Therefore:
+     *  - broadcasts to the target app are explicit (setPackage) and carry the receiver permission
+     *    below, which the user must grant to the target app; the system then only delivers them to
+     *    holders of a permission that this app defines,
+     *  - broadcasts from the target app are only accepted if the sender holds the same permission
+     *    and the system reports the target package's uid as the sender,
+     *  - only fixed, allowlisted actions are relayed; payloads are never forwarded and health
+     *    telemetry is never broadcast or logged.
+     */
+    private static final String APP_BRIDGE_PERMISSION =
+            "nodomain.freeyourgadget.gadgetbridge.permission.APP_BRIDGE";
+    private static final String ACTION_SEND_TO_WATCH =
+            "nodomain.freeyourgadget.gadgetbridge.ACTION_SEND_TO_WATCH";
+    private static final String ACTION_RECEIVE_FROM_WATCH =
+            "nodomain.freeyourgadget.gadgetbridge.ACTION_RECEIVE_FROM_WATCH";
+    private static final String CAMERA_PACKAGE = "app.grapheneos.camera";
+    private static final String CAMERA_APP_ID = "org.asteroidos.camera";
+    private static final String CAMERA_WIRE_APP_ID = "cam";
+    private static final int APP_BRIDGE_MAX_PACKET = 512;
+    private static final Set<String> WATCH_TO_PHONE_ACTIONS = new HashSet<>(Arrays.asList(
+            "capture", "flip", "zoom_in", "zoom_out", "torch", "mode_photo", "mode_video",
+            "status_query"));
+    private static final Set<String> PHONE_TO_WATCH_ACTIONS = new HashSet<>(Arrays.asList(
+            "ready", "paused", "photo_captured", "video_started", "video_stopped"));
+
+    private BroadcastReceiver appBridgeReceiver = null;
+
+    private void registerAppBridgeReceiver() {
+        if (appBridgeReceiver != null) return;
+        final Context context = GBApplication.getContext();
+        appBridgeReceiver = new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context ctx, Intent intent) {
+                handleSendToWatchIntent(intent, this);
+            }
+        };
+        // RECEIVER_EXPORTED is needed to hear another app; the broadcast permission restricts
+        // senders to holders of APP_BRIDGE_PERMISSION.
+        ContextCompat.registerReceiver(
+                context,
+                appBridgeReceiver,
+                new IntentFilter(ACTION_SEND_TO_WATCH),
+                APP_BRIDGE_PERMISSION,
+                null,
+                ContextCompat.RECEIVER_EXPORTED
+        );
+    }
+
+    @Override
+    public void dispose() {
+        super.dispose();
+        if (appBridgeReceiver != null) {
+            try {
+                GBApplication.getContext().unregisterReceiver(appBridgeReceiver);
+            } catch (IllegalArgumentException e) {
+                LOG.warn("Failed to unregister appBridgeReceiver", e);
+            }
+            appBridgeReceiver = null;
+        }
+    }
+
+    private boolean isSentFromCameraApp(final BroadcastReceiver receiver) {
+        // Fail closed: the sender uid is only available on Android 14+.
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false;
+        final int sentFromUid = receiver.getSentFromUid();
+        if (sentFromUid == Process.INVALID_UID) return false;
+        try {
+            return getContext().getPackageManager().getPackageUid(CAMERA_PACKAGE, 0) == sentFromUid;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    private void handleSendToWatchIntent(Intent intent, BroadcastReceiver receiver) {
+        if (intent == null || !ACTION_SEND_TO_WATCH.equals(intent.getAction())) return;
+        if (!isSentFromCameraApp(receiver)) {
+            LOG.warn("AppBridge: dropping message not sent by {}", CAMERA_PACKAGE);
+            return;
+        }
+        if (!CAMERA_APP_ID.equals(intent.getStringExtra("extra_app_id"))) return;
+        final String action = intent.getStringExtra("extra_action");
+        if (action == null || !PHONE_TO_WATCH_ACTIONS.contains(action)) return;
+        if (!getDevice().isInitialized()) return;
+        sendAppBridgeMessage(CAMERA_WIRE_APP_ID, action);
+    }
+
+    /**
+     * Process incoming App Bridge frame from AsteroidOS.
+     * Format: [0xA0][appIdLen:1B][appId][actionLen:1B][action][payload]
+     * Only camera remote actions are relayed, without payload.
+     */
+    private void handleAppBridgeData(byte[] value) {
+        if (value == null || value.length < 3 || value.length > APP_BRIDGE_MAX_PACKET) {
+            return;
+        }
+        if ((value[0] & 0xFF) != 0xA0) {
+            LOG.warn("AppBridge: invalid magic byte 0x{}", Integer.toHexString(value[0] & 0xFF));
+            return;
+        }
+        int offset = 1;
+        final int appIdLen = value[offset++] & 0xFF;
+        if (value.length < offset + appIdLen + 1) return;
+        final String appId = new String(value, offset, appIdLen, StandardCharsets.UTF_8);
+        offset += appIdLen;
+
+        final int actionLen = value[offset++] & 0xFF;
+        if (value.length < offset + actionLen) return;
+        final String action = new String(value, offset, actionLen, StandardCharsets.UTF_8);
+
+        // Everything but the camera remote (including SpO2 telemetry) stays on the watch link.
+        if (!CAMERA_WIRE_APP_ID.equals(appId) || !WATCH_TO_PHONE_ACTIONS.contains(action)) {
+            LOG.debug("AppBridge: ignoring frame for unsupported app or action");
+            return;
+        }
+
+        final Intent broadcast = new Intent(ACTION_RECEIVE_FROM_WATCH)
+                .setPackage(CAMERA_PACKAGE)
+                .putExtra("extra_app_id", CAMERA_APP_ID)
+                .putExtra("extra_action", action);
+        // Delivered only to the camera app and only if the user granted it the bridge permission.
+        getContext().sendBroadcast(broadcast, APP_BRIDGE_PERMISSION);
+    }
+
+    private void sendAppBridgeMessage(String wireAppId, String action) {
+        final byte[] appIdBytes = wireAppId.getBytes(StandardCharsets.UTF_8);
+        final byte[] actionBytes = action.getBytes(StandardCharsets.UTF_8);
+        final byte[] packet = new byte[3 + appIdBytes.length + actionBytes.length];
+        int idx = 0;
+        packet[idx++] = (byte) 0xA0;
+        packet[idx++] = (byte) appIdBytes.length;
+        System.arraycopy(appIdBytes, 0, packet, idx, appIdBytes.length);
+        idx += appIdBytes.length;
+        packet[idx++] = (byte) actionBytes.length;
+        System.arraycopy(actionBytes, 0, packet, idx, actionBytes.length);
+
+        final TransactionBuilder builder = createTransactionBuilder("sendAppBridgeMessage");
+        safeWriteToCharacteristic(builder, AsteroidOSConstants.APP_BRIDGE_RX_CHAR, packet);
+        builder.queue();
+    }
+
