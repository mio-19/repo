+    /**
+     * Process generic incoming App Bridge notification from AsteroidOS.
+     * Format: [0xA0][appIdLen:1B][appId][actionLen:1B][action][payload]
+     */
+    private void handleAppBridgeData(byte[] value) {
+        if (value == null || value.length < 3) {
+            return;
+        }
+        if ((value[0] & 0xFF) != 0xA0) {
+            LOG.warn("AppBridge: invalid magic byte 0x{}", Integer.toHexString(value[0] & 0xFF));
+            return;
+        }
+        try {
+            int offset = 1;
+            int appIdLen = value[offset++] & 0xFF;
+            if (value.length < offset + appIdLen + 1) return;
+            String appId = new String(value, offset, appIdLen, StandardCharsets.UTF_8);
+            offset += appIdLen;
+
+            int actionLen = value[offset++] & 0xFF;
+            if (value.length < offset + actionLen) return;
+            String action = new String(value, offset, actionLen, StandardCharsets.UTF_8);
+            offset += actionLen;
+
+            int payloadLen = value.length - offset;
+            byte[] payload = new byte[payloadLen];
+            System.arraycopy(value, offset, payload, 0, payloadLen);
+            String payloadStr = new String(payload, StandardCharsets.UTF_8);
+
+            LOG.info("AppBridge message received: app={}, action={}, bytes={}", appId, action, payloadLen);
+
+            // Broadcast to all Android applications
+            android.content.Intent broadcast = new android.content.Intent("nodomain.freeyourgadget.gadgetbridge.ACTION_RECEIVE_FROM_WATCH");
+            broadcast.putExtra("extra_app_id", appId);
+            broadcast.putExtra("extra_action", action);
+            broadcast.putExtra("extra_payload_bytes", payload);
+            broadcast.putExtra("extra_payload_string", payloadStr);
+            getContext().sendBroadcast(broadcast);
+
+            // Native telemetry integration: SpO2 & Heart Rate
+            if ("org.asteroidos.spo2".equals(appId) && "measurement".equals(action)) {
+                try {
+                    JSONObject json = new JSONObject(payloadStr);
+                    int spo2 = json.optInt("spo2", 0);
+                    int bpm = json.optInt("bpm", 0);
+                    LOG.info("Native AsteroidOS SpO2 recorded: SpO2={}% BPM={}", spo2, bpm);
+                } catch (Exception ex) {
+                    LOG.warn("Failed to parse SpO2 payload as JSON", ex);
+                }
+            }
+        } catch (Exception e) {
+            LOG.error("Failed to parse AppBridge data", e);
+        }
+    }
+
+    private void sendAppBridgeMessage(String appId, String action, byte[] payload) {
+        try {
+            byte[] appIdBytes = appId.getBytes(StandardCharsets.UTF_8);
+            byte[] actionBytes = action.getBytes(StandardCharsets.UTF_8);
+            if (appIdBytes.length > 255 || actionBytes.length > 255) {
+                LOG.warn("AppBridge: appId or action length exceeds 255 bytes");
+                return;
+            }
+            byte[] packet = new byte[3 + appIdBytes.length + actionBytes.length + payload.length];
+            int idx = 0;
+            packet[idx++] = (byte) 0xA0;
+            packet[idx++] = (byte) appIdBytes.length;
+            System.arraycopy(appIdBytes, 0, packet, idx, appIdBytes.length);
+            idx += appIdBytes.length;
+            packet[idx++] = (byte) actionBytes.length;
+            System.arraycopy(actionBytes, 0, packet, idx, actionBytes.length);
+            idx += actionBytes.length;
+            System.arraycopy(payload, 0, packet, idx, payload.length);
+
+            TransactionBuilder builder = performInitialized("sendAppBridgeMessage");
+            builder.write(getCharacteristic(AsteroidOSConstants.APP_BRIDGE_RX_CHAR), packet);
+            builder.queue(getQueue());
+            LOG.info("Queued AppBridge message to watch: app={}, action={}", appId, action);
+        } catch (Exception e) {
+            LOG.error("Error sending AppBridge message", e);
+        }
+    }
