+    private var remoteCameraReceiver: BroadcastReceiver? = null
+
+    private fun registerRemoteCameraReceiver() {
+        if (remoteCameraReceiver != null) return
+        val filter = IntentFilter(ACTION_RECEIVE_FROM_WATCH)
+        remoteCameraReceiver = object : BroadcastReceiver() {
+            override fun onReceive(context: Context?, intent: Intent?) {
+                if (intent == null) return
+                val appId = intent.getStringExtra("extra_app_id")
+                if (appId != WATCH_APP_CAMERA) return
+                val action = intent.getStringExtra("extra_action") ?: return
+                Log.i(TAG, "Remote camera command received: $action")
+                handleRemoteCameraAction(action, intent.getStringExtra("extra_payload_string"))
+            }
+        }
+        ContextCompat.registerReceiver(this, remoteCameraReceiver!!, filter, ContextCompat.RECEIVER_EXPORTED)
+    }
+
+    private fun unregisterRemoteCameraReceiver() {
+        remoteCameraReceiver?.let {
+            try {
+                unregisterReceiver(it)
+            } catch (e: Exception) {
+                Log.w(TAG, "Failed to unregister remoteCameraReceiver", e)
+            }
+            remoteCameraReceiver = null
+        }
+    }
+
+    private fun handleRemoteCameraAction(action: String, payload: String?) {
+        runOnUiThread {
+            when (action) {
+                "capture", "shutter" -> {
+                    captureButton.performClick()
+                }
+                "flip", "switch_camera" -> {
+                    camConfig.toggleCameraSelector()
+                }
+                "zoom_in" -> {
+                    cameraControl.zoomIn()
+                }
+                "zoom_out" -> {
+                    cameraControl.zoomOut()
+                }
+                "torch", "toggle_torch" -> {
+                    camConfig.toggleTorchState()
+                }
+                "status_query", "ping" -> {
+                    sendWatchCameraStatus("ready")
+                }
+            }
+        }
+    }
+
+    fun sendWatchCameraStatus(status: String) {
+        try {
+            val intent = Intent(ACTION_SEND_TO_WATCH).apply {
+                putExtra("extra_app_id", WATCH_APP_CAMERA)
+                putExtra("extra_action", status)
+                putExtra("extra_payload_string", "{\"status\":\"$status\"}")
+            }
+            sendBroadcast(intent)
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to broadcast status to watch", e)
+        }
+    }
+
