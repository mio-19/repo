+    override fun onNewIntent(intent: Intent?) {
+        super.onNewIntent(intent)
+        intent?.getStringExtra("extra_remote_action")?.let { action ->
+            intent.removeExtra("extra_remote_action")
+            handleRemoteCameraAction(action, null)
+        }
+    }
+
+    private var remoteCameraReceiver: BroadcastReceiver? = null
+
+    private fun registerRemoteCameraReceiver() {
+        if (remoteCameraReceiver != null) return
+        val filter = IntentFilter(ACTION_RECEIVE_FROM_WATCH)
+        remoteCameraReceiver = object : BroadcastReceiver() {
+            override fun onReceive(context: Context?, intent: Intent?) {
+                if (intent == null) return
+                val appId = intent.getStringExtra("extra_app_id")
+                if (appId != WATCH_APP_CAMERA) return
+                val action = intent.getStringExtra("extra_action") ?: return
+                Log.i(TAG, "Remote camera command received: $action")
+                handleRemoteCameraAction(action, intent.getStringExtra("extra_payload_string"))
+            }
+        }
+        ContextCompat.registerReceiver(this, remoteCameraReceiver!!, filter, ContextCompat.RECEIVER_EXPORTED)
+    }
+
+    private fun unregisterRemoteCameraReceiver() {
+        remoteCameraReceiver?.let {
+            try {
+                unregisterReceiver(it)
+            } catch (e: Exception) {
+                Log.w(TAG, "Failed to unregister remoteCameraReceiver", e)
+            }
+            remoteCameraReceiver = null
+        }
+    }
+
+    private var previewStreamServer: PreviewStreamServer? = null
+    private var previewTicker: Runnable? = null
+    private val previewHandler = Handler(Looper.getMainLooper())
+
+    private fun startPreviewStreaming() {
+        if (previewStreamServer == null) {
+            previewStreamServer = PreviewStreamServer(8089).apply {
+                onControlAction = { action ->
+                    runOnUiThread { handleRemoteCameraAction(action, null) }
+                    true
+                }
+                start()
+            }
+        }
+        if (previewTicker == null) {
+            previewTicker = object : Runnable {
+                override fun run() {
+                    if (!isDestroyed && !isFinishing) {
+                        captureAndPushPreviewFrame()
+                        previewHandler.postDelayed(this, 66L) // ~15 FPS
+                    }
+                }
+            }
+            previewHandler.post(previewTicker!!)
+        }
+    }
+
+    private fun stopPreviewStreaming() {
+        previewTicker?.let { previewHandler.removeCallbacks(it) }
+        previewTicker = null
+        previewStreamServer?.stop()
+        previewStreamServer = null
+    }
+
+    private fun captureAndPushPreviewFrame() {
+        try {
+            val server = previewStreamServer ?: return
+            if (!server.hasClients) return
+            val bitmap = previewView.bitmap ?: return
+            try {
+                val targetSize = 320
+                val scaled = if (bitmap.width > targetSize || bitmap.height > targetSize) {
+                    val scale = targetSize.toFloat() / maxOf(bitmap.width, bitmap.height)
+                    val sw = (bitmap.width * scale).toInt()
+                    val sh = (bitmap.height * scale).toInt()
+                    Bitmap.createScaledBitmap(bitmap, sw, sh, true)
+                } else {
+                    bitmap
+                }
+
+                try {
+                    server.updateFrame(scaled, 65)
+                } finally {
+                    if (scaled !== bitmap) {
+                        scaled.recycle()
+                    }
+                }
+            } finally {
+                bitmap.recycle()
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Error pushing preview frame", e)
+        }
+    }
+
+    private fun handleRemoteCameraAction(action: String, payload: String?) {
+        runOnUiThread {
+            when (action) {
+                "capture", "shutter" -> {
+                    captureButton.performClick()
+                }
+                "flip", "switch_camera" -> {
+                    camConfig.toggleCameraSelector()
+                }
+                "zoom_in" -> {
+                    cameraControl.zoomIn()
+                }
+                "zoom_out" -> {
+                    cameraControl.zoomOut()
+                }
+                "torch", "toggle_torch" -> {
+                    camConfig.toggleTorchState()
+                }
+                "mode_photo" -> {
+                    try {
+                        tabLayout.getTabForMode(CameraMode.CAMERA)?.let { tabLayout.goToTab(it) }
+                    } catch (e: Exception) {
+                        Log.w(TAG, "Failed to switch to photo mode", e)
+                    }
+                }
+                "mode_video" -> {
+                    try {
+                        tabLayout.getTabForMode(CameraMode.VIDEO)?.let { tabLayout.goToTab(it) }
+                    } catch (e: Exception) {
+                        Log.w(TAG, "Failed to switch to video mode", e)
+                    }
+                }
+                "start_stream" -> {
+                    startPreviewStreaming()
+                    sendWatchCameraStatus("stream_ready")
+                }
+                "stop_stream" -> {
+                    stopPreviewStreaming()
+                    sendWatchCameraStatus("stream_stopped")
+                }
+                "status_query", "ping" -> {
+                    sendWatchCameraStatus("ready")
+                }
+            }
+        }
+    }
+
+    fun sendWatchCameraStatus(status: String) {
+        try {
+            val ips = previewStreamServer?.getLocalIpAddresses() ?: emptyList()
+            val ipsJson = ips.joinToString(prefix = "[", postfix = "]") { "\"$it\"" }
+            val payload = "{\"status\":\"$status\",\"port\":8089,\"ips\":$ipsJson}"
+            val intent = Intent(ACTION_SEND_TO_WATCH).apply {
+                putExtra("extra_app_id", WATCH_APP_CAMERA)
+                putExtra("extra_action", status)
+                putExtra("extra_payload_string", payload)
+            }
+            sendBroadcast(intent)
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to broadcast status to watch", e)
+        }
+    }
+
