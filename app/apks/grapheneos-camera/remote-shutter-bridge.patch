diff --git a/app/src/main/java/app/grapheneos/camera/remote/WatchRemote.kt b/app/src/main/java/app/grapheneos/camera/remote/WatchRemote.kt
new file mode 100644
index 00000000..05b47142
--- /dev/null
+++ b/app/src/main/java/app/grapheneos/camera/remote/WatchRemote.kt
@@ -0,0 +1,191 @@
+package app.grapheneos.camera.remote
+
+import android.app.KeyguardManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import android.os.Build
+import android.os.Process
+import android.os.SystemClock
+import android.util.Log
+import androidx.core.content.ContextCompat
+
+/**
+ * Remote shutter for smartwatches, driven by a companion app that holds the BLE connection.
+ *
+ * There is deliberately no network access, no manifest-declared receiver and no exported
+ * activity entry point. Commands are only accepted while the main camera screen is resumed on
+ * an unlocked device, and only when the user explicitly enabled the feature. A bridge app is
+ * trusted only when all of the following hold:
+ *  - the permission it defines is really defined by its package (no permission squatting),
+ *  - the user granted that permission to Camera (runtime permission, doubles as consent),
+ *  - the receiver requires the sender to hold that permission, and
+ *  - the system reported the broadcast as sent from the bridge package's uid.
+ * Outgoing status broadcasts are explicit (setPackage) and carry no data except a fixed status
+ * word, so no other app can observe when the user is taking photos or recording.
+ */
+class WatchRemote(
+    private val context: Context,
+    private val onCommand: (Command) -> Unit,
+) {
+    enum class Command(val wire: String) {
+        CAPTURE("capture"),
+        FLIP("flip"),
+        ZOOM_IN("zoom_in"),
+        ZOOM_OUT("zoom_out"),
+        TORCH("torch"),
+        MODE_PHOTO("mode_photo"),
+        MODE_VIDEO("mode_video"),
+        STATUS_QUERY("status_query");
+
+        companion object {
+            fun fromWire(s: String?): Command? = entries.firstOrNull { it.wire == s }
+        }
+    }
+
+    enum class Status(val wire: String) {
+        READY("ready"),
+        PAUSED("paused"),
+        PHOTO_CAPTURED("photo_captured"),
+        VIDEO_STARTED("video_started"),
+        VIDEO_STOPPED("video_stopped"),
+    }
+
+    class Bridge(
+        val pkg: String,
+        val permission: String,
+        val receiveAction: String,
+        val sendAction: String,
+    )
+
+    private val receivers = ArrayList<BroadcastReceiver>()
+    private var lastCommandAt = 0L
+
+    val isActive: Boolean
+        get() = receivers.isNotEmpty()
+
+    /** Registers receivers for every usable bridge. Call from onResume(). */
+    fun start() {
+        stop()
+        if (isDeviceLocked()) return
+        for (bridge in usableBridges(context)) {
+            val receiver = object : BroadcastReceiver() {
+                override fun onReceive(c: Context, intent: Intent) {
+                    handle(bridge, intent, this)
+                }
+            }
+            val filter = IntentFilter(bridge.receiveAction)
+            // RECEIVER_EXPORTED is required to hear another app; the broadcastPermission
+            // argument is what restricts senders to holders of the bridge permission.
+            ContextCompat.registerReceiver(
+                context, receiver, filter, bridge.permission, null,
+                ContextCompat.RECEIVER_EXPORTED,
+            )
+            receivers.add(receiver)
+        }
+    }
+
+    /** Unregisters all receivers. Call from onPause(). */
+    fun stop() {
+        for (r in receivers) {
+            try {
+                context.unregisterReceiver(r)
+            } catch (e: IllegalArgumentException) {
+                Log.w(TAG, "receiver was not registered", e)
+            }
+        }
+        receivers.clear()
+    }
+
+    private fun handle(bridge: Bridge, intent: Intent, receiver: BroadcastReceiver) {
+        if (receiver !in receivers) return
+        if (intent.action != bridge.receiveAction) return
+        if (!isFromBridge(bridge, receiver)) {
+            Log.w(TAG, "dropping command not sent by ${bridge.pkg}")
+            return
+        }
+        if (intent.getStringExtra(EXTRA_APP_ID) != WATCH_APP_ID) return
+        val command = Command.fromWire(intent.getStringExtra(EXTRA_ACTION)) ?: return
+        if (isDeviceLocked()) return
+
+        // Debounce so a misbehaving bridge can't hammer the capture pipeline.
+        val now = SystemClock.elapsedRealtime()
+        if (command != Command.STATUS_QUERY && now - lastCommandAt < MIN_COMMAND_INTERVAL_MS) return
+        if (command != Command.STATUS_QUERY) lastCommandAt = now
+
+        onCommand(command)
+    }
+
+    private fun isFromBridge(bridge: Bridge, receiver: BroadcastReceiver): Boolean {
+        // Fail closed: the sender uid is only available on Android 14+.
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false
+        val sentFromUid = receiver.sentFromUid
+        if (sentFromUid == Process.INVALID_UID) return false
+        return try {
+            context.packageManager.getPackageUid(bridge.pkg, 0) == sentFromUid
+        } catch (e: PackageManager.NameNotFoundException) {
+            false
+        }
+    }
+
+    fun sendStatus(status: Status) {
+        for (bridge in usableBridges(context)) {
+            val intent = Intent(bridge.sendAction)
+                .setPackage(bridge.pkg)
+                .putExtra(EXTRA_APP_ID, WATCH_APP_ID)
+                .putExtra(EXTRA_ACTION, status.wire)
+            // The receiver permission makes the system deliver only to the bridge app,
+            // and only if it holds the permission it defined itself.
+            context.sendBroadcast(intent, bridge.permission)
+        }
+    }
+
+    private fun isDeviceLocked(): Boolean {
+        val km = context.getSystemService(KeyguardManager::class.java)
+        return km == null || km.isKeyguardLocked
+    }
+
+    companion object {
+        private const val TAG = "WatchRemote"
+        private const val MIN_COMMAND_INTERVAL_MS = 400L
+
+        const val WATCH_APP_ID = "org.asteroidos.camera"
+        const val EXTRA_APP_ID = "extra_app_id"
+        const val EXTRA_ACTION = "extra_action"
+
+        val BRIDGES = listOf(
+            Bridge(
+                pkg = "nodomain.freeyourgadget.gadgetbridge",
+                permission = "nodomain.freeyourgadget.gadgetbridge.permission.APP_BRIDGE",
+                receiveAction = "nodomain.freeyourgadget.gadgetbridge.ACTION_RECEIVE_FROM_WATCH",
+                sendAction = "nodomain.freeyourgadget.gadgetbridge.ACTION_SEND_TO_WATCH",
+            ),
+            Bridge(
+                pkg = "org.asteroidos.sync",
+                permission = "org.asteroidos.sync.permission.APP_BRIDGE",
+                receiveAction = "org.asteroidos.sync.ACTION_RECEIVE_FROM_WATCH",
+                sendAction = "org.asteroidos.sync.ACTION_SEND_TO_WATCH",
+            ),
+        )
+
+        /** True if [bridge]'s package is installed and really defines its permission. */
+        fun isBridgeInstalled(context: Context, bridge: Bridge): Boolean {
+            return try {
+                context.packageManager.getPermissionInfo(bridge.permission, 0).packageName == bridge.pkg
+            } catch (e: PackageManager.NameNotFoundException) {
+                false
+            }
+        }
+
+        fun isBridgeGranted(context: Context, bridge: Bridge): Boolean {
+            return context.checkSelfPermission(bridge.permission) == PackageManager.PERMISSION_GRANTED
+        }
+
+        fun installedBridges(context: Context) = BRIDGES.filter { isBridgeInstalled(context, it) }
+
+        fun usableBridges(context: Context) =
+            BRIDGES.filter { isBridgeInstalled(context, it) && isBridgeGranted(context, it) }
+    }
+}
