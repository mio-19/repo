+    private var watchRemote: WatchRemote? = null
+
+    // Only the plain main screen takes remote commands: not the secure (lockscreen) variants and
+    // not the variants started by other apps for a single capture.
+    private val watchRemoteAllowed: Boolean
+        get() = javaClass == MainActivity::class.java
+
+    private fun startWatchRemote() {
+        if (!watchRemoteAllowed || !camConfig.watchRemoteEnabled) return
+        val remote = watchRemote ?: WatchRemote(this, ::handleWatchCommand).also { watchRemote = it }
+        remote.start()
+        if (remote.isActive) {
+            remote.sendStatus(WatchRemote.Status.READY)
+        }
+    }
+
+    private fun stopWatchRemote() {
+        val remote = watchRemote ?: return
+        if (remote.isActive) {
+            remote.sendStatus(WatchRemote.Status.PAUSED)
+        }
+        remote.stop()
+    }
+
+    fun sendWatchStatus(status: WatchRemote.Status) {
+        val remote = watchRemote ?: return
+        if (remote.isActive) {
+            remote.sendStatus(status)
+        }
+    }
+
+    private fun handleWatchCommand(command: WatchRemote.Command) {
+        if (!lifecycle.currentState.isAtLeast(Lifecycle.State.RESUMED)) return
+        if (command == WatchRemote.Command.STATUS_QUERY) {
+            sendWatchStatus(WatchRemote.Status.READY)
+            return
+        }
+        // there are no camera controls in qr mode
+        if (camConfig.isQRMode) return
+
+        when (command) {
+            WatchRemote.Command.CAPTURE -> captureButton.performClick()
+            WatchRemote.Command.FLIP -> camConfig.toggleCameraSelector()
+            WatchRemote.Command.ZOOM_IN -> cameraControl.zoomIn()
+            WatchRemote.Command.ZOOM_OUT -> cameraControl.zoomOut()
+            WatchRemote.Command.TORCH -> camConfig.toggleTorchState()
+            WatchRemote.Command.MODE_PHOTO ->
+                tabLayout.getTabForMode(CameraMode.CAMERA)?.let { tabLayout.goToTab(it) }
+            WatchRemote.Command.MODE_VIDEO ->
+                tabLayout.getTabForMode(CameraMode.VIDEO)?.let { tabLayout.goToTab(it) }
+            WatchRemote.Command.STATUS_QUERY -> {}
+        }
+    }
