diff --git a/src/com/android/messaging/data/webdavsync/WebDavClient.kt b/src/com/android/messaging/data/webdavsync/WebDavClient.kt
new file mode 100644
index 00000000..884f31f4
--- /dev/null
+++ b/src/com/android/messaging/data/webdavsync/WebDavClient.kt
@@ -0,0 +1,184 @@
+package com.android.messaging.data.webdavsync
+
+import android.util.Base64
+import java.io.File
+import java.io.IOException
+import java.io.InputStream
+import java.net.HttpURLConnection
+import java.net.URI
+import java.net.URL
+
+internal class WebDavClient(
+    private val username: String,
+    private val password: String,
+) {
+    private val ensuredCollections = HashSet<String>()
+
+    fun downloadText(fileUrl: String): String? {
+        val connection = openConnection(fileUrl, METHOD_GET)
+        try {
+            val responseCode = connection.responseCode
+            if (responseCode == HTTP_NOT_FOUND) {
+                return null
+            }
+            if (responseCode !in HTTP_SUCCESS_RANGE) {
+                throw IOException("HTTP $responseCode while downloading sync file")
+            }
+            return connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText() }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun uploadText(fileUrl: String, body: String) {
+        val bytes = body.toByteArray(Charsets.UTF_8)
+        val connection = openConnection(fileUrl, METHOD_PUT)
+        try {
+            connection.doOutput = true
+            connection.setFixedLengthStreamingMode(bytes.size)
+            connection.setRequestProperty("Content-Type", JSON_CONTENT_TYPE)
+            connection.outputStream.use { it.write(bytes) }
+            val responseCode = connection.responseCode
+            if (responseCode !in HTTP_SUCCESS_RANGE) {
+                throw IOException("HTTP $responseCode while uploading sync file")
+            }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun uploadFile(
+        url: String,
+        contentType: String,
+        openStream: () -> InputStream?,
+    ) {
+        val connection = openConnection(url, METHOD_PUT)
+        try {
+            connection.doOutput = true
+            connection.setChunkedStreamingMode(CHUNK_SIZE_BYTES)
+            connection.setRequestProperty("Content-Type", contentType)
+            val input = openStream() ?: throw IOException("Cannot open local attachment")
+            input.use { source ->
+                connection.outputStream.use { target ->
+                    source.copyTo(target, CHUNK_SIZE_BYTES)
+                }
+            }
+            val responseCode = connection.responseCode
+            if (responseCode !in HTTP_SUCCESS_RANGE) {
+                throw IOException("HTTP $responseCode while uploading attachment")
+            }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun downloadToFile(url: String, destination: File): Boolean {
+        val connection = openConnection(url, METHOD_GET)
+        try {
+            val responseCode = connection.responseCode
+            if (responseCode == HTTP_NOT_FOUND) {
+                return false
+            }
+            if (responseCode !in HTTP_SUCCESS_RANGE) {
+                throw IOException("HTTP $responseCode while downloading attachment")
+            }
+            connection.inputStream.use { input ->
+                destination.outputStream().use { output ->
+                    input.copyTo(output, CHUNK_SIZE_BYTES)
+                }
+            }
+            return true
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun exists(url: String): Boolean {
+        val connection = openConnection(url, METHOD_HEAD)
+        return try {
+            connection.responseCode in HTTP_SUCCESS_RANGE
+        } catch (exception: IOException) {
+            // Servers that do not implement HEAD land here; the following PUT reports errors.
+            false
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun ensureParentCollections(fileUrl: String) {
+        val uri = URI(fileUrl)
+        val segments = uri.path
+            ?.trim('/')
+            ?.split('/')
+            ?.filter(String::isNotEmpty)
+            .orEmpty()
+        if (segments.size <= 1) {
+            return
+        }
+
+        val parentSegments = segments.dropLast(1)
+        var path = ""
+        for (segment in parentSegments) {
+            path += "/$segment"
+            val collectionUrl = URI(
+                uri.scheme,
+                uri.authority,
+                path,
+                null,
+                null,
+            ).toString() + "/"
+            if (ensuredCollections.add(collectionUrl)) {
+                createCollection(collectionUrl)
+            }
+        }
+    }
+
+    fun mediaUrl(fileUrl: String, remoteName: String): String {
+        val sanitized = WebDavSyncPayloadCodec.sanitizeRemoteName(remoteName)
+            ?: throw IllegalArgumentException("Invalid attachment name")
+        return fileUrl.trimEnd('/') + MEDIA_DIRECTORY_SUFFIX + sanitized
+    }
+
+    private fun createCollection(url: String) {
+        val connection = openConnection(url, METHOD_MKCOL)
+        try {
+            connection.responseCode
+        } catch (exception: IOException) {
+            // Best effort: WebDAV servers commonly answer 405 for an existing collection.
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun openConnection(url: String, method: String): HttpURLConnection {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        connection.requestMethod = method
+        connection.connectTimeout = CONNECT_TIMEOUT_MILLIS
+        connection.readTimeout = READ_TIMEOUT_MILLIS
+        connection.instanceFollowRedirects = true
+        connection.setRequestProperty("User-Agent", USER_AGENT)
+        if (username.isNotBlank()) {
+            val credentials = "$username:$password".toByteArray(Charsets.UTF_8)
+            connection.setRequestProperty(
+                "Authorization",
+                "Basic " + Base64.encodeToString(credentials, Base64.NO_WRAP),
+            )
+        }
+        return connection
+    }
+
+    private companion object {
+        const val METHOD_GET = "GET"
+        const val METHOD_HEAD = "HEAD"
+        const val METHOD_PUT = "PUT"
+        const val METHOD_MKCOL = "MKCOL"
+        const val HTTP_NOT_FOUND = 404
+        val HTTP_SUCCESS_RANGE = 200..299
+        const val CONNECT_TIMEOUT_MILLIS = 30_000
+        const val READ_TIMEOUT_MILLIS = 90_000
+        const val CHUNK_SIZE_BYTES = 64 * 1024
+        const val JSON_CONTENT_TYPE = "application/json; charset=utf-8"
+        const val MEDIA_DIRECTORY_SUFFIX = ".media/"
+        const val USER_AGENT = "GrapheneOS-Messaging-WebDAV-Sync/1"
+    }
+}
diff --git a/src/com/android/messaging/data/webdavsync/WebDavCredentialCipher.kt b/src/com/android/messaging/data/webdavsync/WebDavCredentialCipher.kt
