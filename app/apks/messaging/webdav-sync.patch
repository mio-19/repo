+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Scaffold
+import androidx.compose.material3.Text
+import androidx.compose.material3.TopAppBarDefaults
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.nestedscroll.nestedScroll
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.input.KeyboardType
+import androidx.compose.ui.text.input.PasswordVisualTransformation
+import androidx.compose.ui.tooling.preview.PreviewLightDark
+import androidx.compose.ui.unit.dp
+import com.android.messaging.R
+import com.android.messaging.ui.appsettings.common.SettingsSwitchItem
+import com.android.messaging.ui.appsettings.common.SettingsTopAppBar
+import com.android.messaging.ui.appsettings.webdavsync.model.WebDavSyncAction
+import com.android.messaging.ui.appsettings.webdavsync.model.WebDavSyncUiState
+import com.android.messaging.ui.core.MessagingPreviewTheme
+import java.text.DateFormat
+import java.util.Date
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+internal fun WebDavSyncScreen(
+    uiState: WebDavSyncUiState,
+    onAction: (WebDavSyncAction) -> Unit,
+    onNavigateBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val scrollBehavior = TopAppBarDefaults.exitUntilCollapsedScrollBehavior()
+
+    Scaffold(
+        modifier = modifier.nestedScroll(scrollBehavior.nestedScrollConnection),
+        topBar = {
+            SettingsTopAppBar(
+                title = stringResource(R.string.webdav_sync_title),
+                onNavigateBack = onNavigateBack,
+                scrollBehavior = scrollBehavior,
+            )
+        },
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = contentPadding,
+        ) {
+            item(key = "intro") {
+                Text(
+                    text = stringResource(R.string.webdav_sync_intro),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 12.dp),
+                )
+            }
+
+            item(key = "file_url") {
+                OutlinedTextField(
+                    value = uiState.fileUrl,
+                    onValueChange = {
+                        onAction(WebDavSyncAction.FileUrlChanged(it))
+                    },
+                    label = {
+                        Text(stringResource(R.string.webdav_sync_url_label))
+                    },
+                    placeholder = {
+                        Text(stringResource(R.string.webdav_sync_url_hint))
+                    },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Uri),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+
+            item(key = "username") {
+                OutlinedTextField(
+                    value = uiState.username,
+                    onValueChange = {
+                        onAction(WebDavSyncAction.UsernameChanged(it))
+                    },
+                    label = {
+                        Text(stringResource(R.string.webdav_sync_username_label))
+                    },
+                    singleLine = true,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+
+            item(key = "password") {
+                OutlinedTextField(
+                    value = uiState.password,
+                    onValueChange = {
+                        onAction(WebDavSyncAction.PasswordChanged(it))
+                    },
+                    label = {
+                        Text(stringResource(R.string.webdav_sync_password_label))
+                    },
+                    singleLine = true,
+                    visualTransformation = PasswordVisualTransformation(),
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password),
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+
+            item(key = "periodic_sync") {
+                SettingsSwitchItem(
+                    title = stringResource(R.string.webdav_sync_periodic_title),
+                    summary = stringResource(R.string.webdav_sync_periodic_summary),
+                    checked = uiState.periodicSyncEnabled,
+                    onCheckedChange = {
+                        onAction(WebDavSyncAction.PeriodicSyncChanged(it))
+                    },
+                )
+            }
+
+            item(key = "actions") {
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 12.dp),
+                    horizontalArrangement = Arrangement.spacedBy(12.dp),
+                ) {
+                    Button(
+                        onClick = {
+                            onAction(WebDavSyncAction.SaveClicked)
+                        },
+                        enabled = !uiState.isSyncing,
+                        modifier = Modifier.weight(1f),
+                    ) {
+                        Text(stringResource(R.string.webdav_sync_save))
+                    }
+                    Button(
+                        onClick = {
+                            onAction(WebDavSyncAction.SyncClicked)
+                        },
+                        enabled = !uiState.isSyncing && uiState.fileUrl.isNotBlank(),
+                        modifier = Modifier.weight(1f),
+                    ) {
+                        Text(stringResource(R.string.webdav_sync_now))
+                    }
+                }
+            }
+
+            if (uiState.isSyncing) {
+                item(key = "progress") {
+                    LinearProgressIndicator(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .padding(horizontal = 16.dp),
+                    )
+                }
+            }
+
+            item(key = "status") {
+                Column(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 12.dp),
+                ) {
+                    Text(
+                        text = stringResource(R.string.webdav_sync_status_label),
+                        style = MaterialTheme.typography.titleSmall,
+                    )
+                    if (uiState.status.isNotBlank()) {
+                        Text(
+                            text = uiState.status,
+                            style = MaterialTheme.typography.bodyMedium,
+                            modifier = Modifier.padding(top = 4.dp),
+                        )
+                    }
+                    Text(
+                        text = if (uiState.lastSyncTime > 0L) {
+                            stringResource(
+                                R.string.webdav_sync_last_sync,
+                                formatSyncTime(uiState.lastSyncTime),
+                            )
+                        } else {
+                            stringResource(R.string.webdav_sync_never)
+                        },
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        modifier = Modifier.padding(top = 4.dp),
+                    )
+                }
+            }
+        }
+    }
+}
+
+private fun formatSyncTime(time: Long): String {
+    return DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT)
+        .format(Date(time))
+}
+
+@PreviewLightDark
+@Composable
+private fun WebDavSyncScreenPreview() {
+    MessagingPreviewTheme {
+        WebDavSyncScreen(
+            uiState = WebDavSyncUiState(
+                fileUrl = "https://cloud.example.com/dav/messaging-sync.json",
+                username = "user",
+                password = "secret",
+                periodicSyncEnabled = true,
+                status = "Synced: 3 imported, 42 uploaded",
+                lastSyncTime = System.currentTimeMillis(),
+                isLoading = false,
+            ),
+            onAction = {},
+            onNavigateBack = {},
+        )
+    }
+}
