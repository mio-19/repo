@@ -0,0 +1,49 @@
+package com.android.messaging.data.webdavsync
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.PowerManager
+import com.android.messaging.di.webdavsync.WebDavSyncEntryPoint
+import dagger.hilt.android.EntryPointAccessors
+import kotlinx.coroutines.launch
+
+internal class WebDavSyncReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != ACTION_SYNC) {
+            return
+        }
+
+        val entryPoint = EntryPointAccessors.fromApplication(
+            context.applicationContext,
+            WebDavSyncEntryPoint::class.java,
+        )
+        val pendingResult = goAsync()
+        val wakeLock = context.getSystemService(PowerManager::class.java)
+            ?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, WAKE_LOCK_TAG)
+            ?.apply { acquire(WAKE_LOCK_TIMEOUT_MILLIS) }
+
+        entryPoint.applicationScope().launch {
+            try {
+                entryPoint.webDavSyncRepository().sync()
+            } finally {
+                runCatching {
+                    entryPoint.webDavSyncScheduler().rescheduleIfEnabled()
+                }
+                wakeLock?.let { lock ->
+                    if (lock.isHeld) {
+                        lock.release()
+                    }
+                }
+                pendingResult.finish()
+            }
+        }
+    }
+
+    companion object {
+        const val ACTION_SYNC = "com.android.messaging.action.WEBDAV_SYNC"
+        private const val WAKE_LOCK_TAG = "messaging:webdav-sync"
+        private const val WAKE_LOCK_TIMEOUT_MILLIS = 10L * 60L * 1000L
+    }
+}
diff --git a/src/com/android/messaging/data/webdavsync/WebDavSyncRepository.kt b/src/com/android/messaging/data/webdavsync/WebDavSyncRepository.kt
new file mode 100644
index 00000000..15eed702
--- /dev/null
+++ b/src/com/android/messaging/data/webdavsync/WebDavSyncRepository.kt
@@ -0,0 +1,758 @@
+package com.android.messaging.data.webdavsync
+
+import android.content.Context
+import android.net.Uri
+import android.webkit.MimeTypeMap
+import com.android.messaging.R
+import com.android.messaging.datamodel.BugleDatabaseOperations
+import com.android.messaging.datamodel.DataModel
+import com.android.messaging.datamodel.DatabaseHelper
+import com.android.messaging.datamodel.DatabaseHelper.ConversationParticipantsColumns
+import com.android.messaging.datamodel.DatabaseHelper.MessageColumns
+import com.android.messaging.datamodel.DatabaseHelper.PartColumns
+import com.android.messaging.datamodel.DatabaseHelper.ParticipantColumns
+import com.android.messaging.datamodel.DatabaseWrapper
+import com.android.messaging.datamodel.MediaScratchFileProvider
+import com.android.messaging.datamodel.MessagingContentProvider
+import com.android.messaging.datamodel.data.MessageData
+import com.android.messaging.datamodel.data.MessagePartData
+import com.android.messaging.datamodel.data.ParticipantData
+import com.android.messaging.di.core.IoDispatcher
+import com.android.messaging.di.core.MessagingDbDispatcher
+import com.android.messaging.sms.MmsUtils
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.net.URI
+import java.security.MessageDigest
+import java.util.Locale
+import javax.inject.Inject
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+internal interface WebDavSyncRepository {
+    suspend fun loadSettings(): WebDavSyncSettings
+    suspend fun saveSettings(settings: WebDavSyncSettings)
+    suspend fun sync(): WebDavSyncResult
+    fun lastSyncTime(): Long
+    fun lastStatus(): String
+}
+
+internal class WebDavSyncRepositoryImpl @Inject constructor(
+    @param:ApplicationContext private val context: Context,
+    @param:IoDispatcher private val ioDispatcher: CoroutineDispatcher,
+    @param:MessagingDbDispatcher private val databaseDispatcher: CoroutineDispatcher,
+    private val preferences: WebDavSyncPreferences,
+) : WebDavSyncRepository {
+
+    private val syncMutex = Mutex()
+
+    override suspend fun loadSettings(): WebDavSyncSettings {
+        return withContext(ioDispatcher) { preferences.load() }
+    }
+
+    override suspend fun saveSettings(settings: WebDavSyncSettings) {
+        withContext(ioDispatcher) { preferences.save(settings) }
+    }
+
+    override fun lastSyncTime(): Long = preferences.lastSyncTime()
+
+    override fun lastStatus(): String = preferences.lastStatus()
+
+    override suspend fun sync(): WebDavSyncResult {
+        return withContext(ioDispatcher) {
+            syncMutex.withLock { syncLocked() }
+        }
+    }
+
+    private suspend fun syncLocked(): WebDavSyncResult {
+        val settings = preferences.load()
+        val rawUrl = settings.fileUrl.trim()
+        if (rawUrl.isEmpty()) {
+            return fail(context.getString(R.string.webdav_sync_url_required))
+        }
+        val fileUrl = normalizeFileUrl(rawUrl)
+            ?: return fail(context.getString(R.string.webdav_sync_invalid_url))
+        if (!fileUrl.startsWith("https://", ignoreCase = true)) {
+            return fail(context.getString(R.string.webdav_sync_https_required))
+        }
+
+        val client = WebDavClient(settings.username, settings.password)
+        return try {
+            client.ensureParentCollections(fileUrl)
+            client.ensureParentCollections(client.mediaUrl(fileUrl, "placeholder"))
+
+            val remoteMessages = client.downloadText(fileUrl)
+                ?.let(WebDavSyncPayloadCodec::decode)
+                .orEmpty()
+                .map(::normalizeRemoteMessage)
+            val mediaCache = HashMap<String, MediaHash?>()
+            val localBefore = readSnapshot(mediaCache)
+            val localKeys = localBefore.messages.mapTo(HashSet()) { it.key }
+
+            val messagesToImport = LinkedHashMap<String, SyncMessage>()
+            for (message in remoteMessages) {
+                if (message.key !in localKeys) {
+                    messagesToImport.putIfAbsent(message.key, message)
+                }
+            }
+
+            val download = downloadMedia(client, fileUrl, messagesToImport.values)
+            val imported = importMessages(download.importable)
+
+            val localAfter = readSnapshot(mediaCache)
+            val uploadedMedia = uploadMedia(client, fileUrl, localAfter)
+
+            val localKeysAfter = localAfter.messages.mapTo(HashSet()) { it.key }
+            val remainingRemote = download.skipped.filter { it.key !in localKeysAfter }
+            val merged = (localAfter.messages + remainingRemote)
+                .associateBy { it.key }
+                .values
+
+            client.uploadText(fileUrl, WebDavSyncPayloadCodec.encode(merged))
+
+            val result = WebDavSyncResult.Success(
+                importedMessages = imported,
+                uploadedMessages = merged.size,
+                downloadedMedia = download.downloadedMedia,
+                uploadedMedia = uploadedMedia,
+                skippedMessages = download.skipped.size,
+            )
+            record(result)
+            result
+        } catch (exception: Exception) {
+            fail(exception.message ?: exception.javaClass.simpleName)
+        }
+    }
+
+    private fun fail(reason: String): WebDavSyncResult.Failure {
+        val result = WebDavSyncResult.Failure(reason)
+        record(result)
+        return result
+    }
+
+    private fun record(result: WebDavSyncResult) {
+        val status = when (result) {
+            is WebDavSyncResult.Success -> context.getString(
+                R.string.webdav_sync_success,
+                result.importedMessages,
+                result.uploadedMessages,
+                result.downloadedMedia,
+                result.uploadedMedia,
+                result.skippedMessages,
+            )
+
+            is WebDavSyncResult.Failure -> context.getString(
+                R.string.webdav_sync_failure,
+                result.reason,
+            )
+        }
+        preferences.saveLastSync(System.currentTimeMillis(), status)
+    }
+
+    private fun normalizeFileUrl(rawUrl: String): String? {
+        val trimmed = rawUrl.trim()
+        if (trimmed.isEmpty()) {
+            return null
+        }
+        val withFileName = if (trimmed.endsWith('/')) {
+            trimmed + DEFAULT_FILE_NAME
+        } else {
+            trimmed
+        }
+        return try {
+            val uri = URI(withFileName)
+            if (uri.scheme.isNullOrBlank() || uri.host.isNullOrBlank()) {
+                null
+            } else if (uri.userInfo != null || uri.query != null || uri.fragment != null) {
+                null
+            } else {
+                withFileName
+            }
+        } catch (exception: Exception) {
+            null
+        }
+    }
+
+    private suspend fun readSnapshot(
+        mediaCache: MutableMap<String, MediaHash?>,
+    ): SyncSnapshot {
+        val rows = withContext(databaseDispatcher) { readSnapshotRows() }
+        return buildSnapshot(rows, mediaCache)
+    }
+
+    private fun readSnapshotRows(): SnapshotRows {
+        val db = DataModel.get().getDatabase()
+        val participants = readConversationParticipants(db)
+        val rows = ArrayList<SnapshotRow>()
+        db.rawQuery(SNAPSHOT_QUERY, null).use { cursor ->
+            while (cursor.moveToNext()) {
+                val messageId = cursor.getString(INDEX_MESSAGE_ID) ?: continue
+                rows.add(
+                    SnapshotRow(
+                        messageId = messageId,
+                        conversationId = cursor.getString(INDEX_CONVERSATION_ID),
+                        outgoing = cursor.getString(INDEX_SENDER_ID)
+                            ?.let { it == cursor.getString(INDEX_SELF_ID) }
+                            ?: false,
+                        sender = cursor.getString(INDEX_SENDER_DESTINATION),
+                        sentTimestamp = cursor.getLong(INDEX_SENT_TIMESTAMP),
+                        receivedTimestamp = cursor.getLong(INDEX_RECEIVED_TIMESTAMP),
+                        subject = cursor.getString(INDEX_SUBJECT),
+                        seen = cursor.getInt(INDEX_SEEN) != 0,
+                        read = cursor.getInt(INDEX_READ) != 0,
+                        partText = cursor.getString(INDEX_PART_TEXT),
+                        partUri = cursor.getString(INDEX_PART_URI),
+                        partContentType = cursor.getString(INDEX_PART_CONTENT_TYPE),
+                        partWidth = cursor.getInt(INDEX_PART_WIDTH),
+                        partHeight = cursor.getInt(INDEX_PART_HEIGHT),
+                    ),
+                )
+            }
+        }
+        return SnapshotRows(participants = participants, rows = rows)
+    }
+
+    private fun buildSnapshot(
+        snapshotRows: SnapshotRows,
+        mediaCache: MutableMap<String, MediaHash?>,
+    ): SyncSnapshot {
+        val builders = LinkedHashMap<String, MessageBuilder>()
+        for (row in snapshotRows.rows) {
+            val builder = builders.getOrPut(row.messageId) {
+                MessageBuilder(
+                    conversationId = row.conversationId,
+                    outgoing = row.outgoing,
+                    sender = row.sender,
+                    sentTimestamp = row.sentTimestamp,
+                    receivedTimestamp = row.receivedTimestamp,
+                    subject = row.subject,
+                    seen = row.seen,
+                    read = row.read,
+                )
+            }
+
+            if (!row.partText.isNullOrEmpty()) {
+                builder.textParts.add(row.partText)
+            }
+
+            val partUri = row.partUri
+            if (!partUri.isNullOrEmpty()) {
+                val contentType = row.partContentType
+                    ?.substringBefore(';')
+                    ?.trim()
+                    ?.takeIf(String::isNotEmpty)
+                    ?: DEFAULT_CONTENT_TYPE
+                val media = hashMedia(
+                    uriString = partUri,
+                    contentType = contentType,
+                    width = row.partWidth,
+                    height = row.partHeight,
+                    mediaCache = mediaCache,
+                )
+                if (media != null) {
+                    builder.media.add(media)
+                }
+            }
+        }
+
+        val mediaByRemoteName = LinkedHashMap<String, LocalMedia>()
+        val messages = LinkedHashMap<String, SyncMessage>()
+        for (builder in builders.values) {
+            val conversationId = builder.conversationId ?: continue
+            val participants = snapshotRows.participants[conversationId]
+                .orEmpty()
+                .sorted()
+            if (participants.isEmpty()) {
+                continue
+            }
+
+            val text = builder.textParts
+                .joinToString("\n")
+                .ifEmpty { builder.subject.orEmpty() }
+            val sender = if (builder.outgoing) null else builder.sender
+            val media = builder.media
+                .distinctBy { it.remoteName }
+                .map { hashed ->
+                    mediaByRemoteName.putIfAbsent(hashed.remoteName, hashed.media)
+                    SyncMedia(
+                        remoteName = hashed.remoteName,
+                        contentType = hashed.media.contentType,
+                        width = hashed.media.width,
+                        height = hashed.media.height,
+                        size = hashed.media.size,
+                    )
+                }
+            if (text.isEmpty() && media.isEmpty()) {
+                continue
+            }
+
+            val key = SyncMessageKeys.compute(
+                participants = participants,
+                outgoing = builder.outgoing,
+                sender = sender,
+                sentTimestamp = builder.sentTimestamp,
+                text = text,
+            )
+            messages.putIfAbsent(
+                key,
+                SyncMessage(
+                    key = key,
+                    participants = participants,
+                    outgoing = builder.outgoing,
+                    sender = sender,
+                    sentTimestamp = builder.sentTimestamp,
+                    receivedTimestamp = builder.receivedTimestamp,
+                    subject = builder.subject,
+                    text = text,
+                    seen = builder.seen,
+                    read = builder.read,
+                    media = media,
+                ),
+            )
+        }
+        return SyncSnapshot(
+            messages = messages.values.toList(),
+            mediaByRemoteName = mediaByRemoteName,
+        )
+    }
+
+    private fun readConversationParticipants(db: DatabaseWrapper): Map<String, List<String>> {
+        val participants = HashMap<String, MutableList<String>>()
+        db.rawQuery(PARTICIPANTS_QUERY, null).use { cursor ->
+            while (cursor.moveToNext()) {
+                val conversationId = cursor.getString(0) ?: continue
+                val destination = cursor.getString(1) ?: continue
+                participants.getOrPut(conversationId) { ArrayList() }.add(destination)
+            }
+        }
+        return participants
+    }
+
+    private fun hashMedia(
+        uriString: String,
+        contentType: String,
+        width: Int,
+        height: Int,
+        mediaCache: MutableMap<String, MediaHash?>,
+    ): MediaHash? {
+        if (mediaCache.containsKey(uriString)) {
+            return mediaCache[uriString]
+        }
+
+        val result = try {
+            val uri = Uri.parse(uriString)
+            val digest = MessageDigest.getInstance("SHA-256")
+            var size = 0L
+            val input = context.contentResolver.openInputStream(uri)
+            if (input == null) {
+                mediaCache[uriString] = null
+                return null
+            }
+            input.use { stream ->
+                val buffer = ByteArray(HASH_BUFFER_BYTES)
+                while (true) {
+                    val read = stream.read(buffer)
+                    if (read < 0) {
+                        break
+                    }
+                    size += read
+                    if (size > MAX_MEDIA_BYTES) {
+                        mediaCache[uriString] = null
+                        return null
+                    }
+                    digest.update(buffer, 0, read)
+                }
+            }
+            val remoteName = SyncMessageKeys.toHex(digest.digest()) + "." + extensionFor(contentType)
+            MediaHash(
+                remoteName = remoteName,
+                media = LocalMedia(
+                    contentUri = uri,
+                    contentType = contentType,
+                    width = width,
+                    height = height,
+                    size = size,
+                ),
+            )
+        } catch (exception: Exception) {
+            null
+        }
+        mediaCache[uriString] = result
+        return result
+    }
+
+    private fun downloadMedia(
+        client: WebDavClient,
+        fileUrl: String,
+        messages: Collection<SyncMessage>,
+    ): DownloadResult {
+        val importable = ArrayList<ImportPlan>()
+        val skipped = ArrayList<SyncMessage>()
+        val downloadedCache = HashMap<String, Uri?>()
+        var downloadedMedia = 0
+
+        for (message in messages) {
+            val mediaUris = ArrayList<Uri>(message.media.size)
+            var failed = false
+            for (media in message.media) {
+                val alreadyDownloaded = downloadedCache.containsKey(media.remoteName)
+                val uri = if (alreadyDownloaded) {
+                    downloadedCache[media.remoteName]
+                } else {
+                    val downloadedUri = downloadMediaFile(client, fileUrl, media)
+                    downloadedCache[media.remoteName] = downloadedUri
+                    downloadedUri
+                }
+                if (uri == null) {
+                    failed = true
+                    break
+                }
+                if (!alreadyDownloaded) {
+                    downloadedMedia++
+                }
+                mediaUris.add(uri)
+            }
+            if (failed) {
+                skipped.add(message)
+            } else {
+                importable.add(ImportPlan(message = message, mediaUris = mediaUris))
+            }
+        }
+        return DownloadResult(
+            importable = importable,
+            skipped = skipped,
+            downloadedMedia = downloadedMedia,
+        )
+    }
+
+    private fun downloadMediaFile(
+        client: WebDavClient,
+        fileUrl: String,
+        media: SyncMedia,
+    ): Uri? {
+        val url = client.mediaUrl(fileUrl, media.remoteName)
+        val scratchUri = MediaScratchFileProvider.buildMediaScratchSpaceUri(
+            extensionFor(media.contentType),
+        )
+        val destination = MediaScratchFileProvider.getFileFromUri(scratchUri) ?: return null
+        return try {
+            if (client.downloadToFile(url, destination)) {
+                scratchUri
+            } else {
+                destination.delete()
+                null
+            }
+        } catch (exception: Exception) {
+            destination.delete()
+            null
+        }
+    }
+
+    private suspend fun importMessages(plans: List<ImportPlan>): Int {
+        if (plans.isEmpty()) {
+            return 0
+        }
+        return withContext(databaseDispatcher) { importMessagesLocked(plans) }
+    }
+
+    private fun importMessagesLocked(plans: List<ImportPlan>): Int {
+        val db = DataModel.get().getDatabase()
+        val touchedConversations = LinkedHashSet<String>()
+        var imported = 0
+        db.beginTransaction()
+        try {
+            val self = ParticipantData.getSelfParticipant(ParticipantData.DEFAULT_SELF_SUB_ID)
+            val selfId = BugleDatabaseOperations.getOrCreateParticipantInTransaction(db, self)
+            for (plan in plans) {
+                val message = plan.message
+                val participants = message.participants
+                    .map(::canonicalize)
+                    .distinct()
+                    .sorted()
+                if (participants.isEmpty()) {
+                    continue
+                }
+                val conversationId = getOrCreateConversation(db, participants) ?: continue
+                val senderId = if (message.outgoing) {
+                    selfId
+                } else {
+                    val sender = canonicalize(message.sender ?: participants.first())
+                    BugleDatabaseOperations.getOrCreateParticipantInTransaction(
+                        db,
+                        ParticipantData.getFromRawPhoneBySimLocale(
+                            sender,
+                            ParticipantData.DEFAULT_SELF_SUB_ID,
+                        ),
+                    )
+                }
+
+                val data = MessageData.createSyncedMessage(
+                    senderId,
+                    selfId,
+                    conversationId,
+                    message.outgoing,
+                    message.seen,
+                    message.read,
+                    message.sentTimestamp,
+                    message.receivedTimestamp,
+                    message.text,
+                )
+                for ((index, media) in message.media.withIndex()) {
+                    val mediaUri = plan.mediaUris.getOrNull(index) ?: continue
+                    data.addPart(
+                        MessagePartData.createMediaMessagePart(
+                            media.contentType,
+                            mediaUri,
+                            media.width,
+                            media.height,
+                        ),
+                    )
+                }
+                BugleDatabaseOperations.insertNewMessageInTransaction(db, data)
+                touchedConversations.add(conversationId)
+                imported++
+            }
+
+            for (conversationId in touchedConversations) {
+                BugleDatabaseOperations.refreshConversationMetadataInTransaction(
+                    db,
+                    conversationId,
+                    false,
+                    false,
+                )
+            }
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+
+        for (conversationId in touchedConversations) {
+            MessagingContentProvider.notifyMessagesChanged(conversationId)
+            MessagingContentProvider.notifyConversationMetadataChanged(conversationId)
+        }
+        MessagingContentProvider.notifyPartsChanged()
+        return imported
+    }
+
+    private fun getOrCreateConversation(
+        db: DatabaseWrapper,
+        participants: List<String>,
+    ): String? {
+        val participantsData = participants.map {
+            ParticipantData.getFromRawPhoneBySimLocale(
+                it,
+                ParticipantData.DEFAULT_SELF_SUB_ID,
+            )
+        }
+        val createdThreadId = try {
+            MmsUtils.getOrCreateThreadId(context, participants)
+        } catch (exception: Exception) {
+            -1L
+        }
+        val threadId = if (createdThreadId > 0) {
+            createdThreadId
+        } else {
+            fallbackThreadId(participants)
+        }
+
+        return BugleDatabaseOperations.getOrCreateConversation(
+            db,
+            threadId,
+            false,
+            ArrayList(participantsData),
+            false,
+            false,
+            null,
+        )
+    }
+
+    private fun fallbackThreadId(participants: List<String>): Long {
+        val digest = MessageDigest.getInstance("SHA-256")
+            .digest(participants.sorted().joinToString("\u0000").toByteArray(Charsets.UTF_8))
+        var value = 0L
+        for (index in 0 until 8) {
+            value = (value shl 8) or (digest[index].toLong() and 0xff)
+        }
+        return -(value and FALLBACK_THREAD_ID_MASK) - 2L
+    }
+
+    private fun canonicalize(destination: String): String {
+        return ParticipantData.getFromRawPhoneBySimLocale(
+            destination,
+            ParticipantData.DEFAULT_SELF_SUB_ID,
+        ).normalizedDestination ?: destination
+    }
+
+    /**
+     * Canonicalize remote destinations before computing their deduplication key. Otherwise a
+     * message whose destination is written differently on the other device would be imported
+     * again on every sync, because the key read from the database would not match the key in the
+     * remote payload.
+     */
+    private fun normalizeRemoteMessage(message: SyncMessage): SyncMessage {
+        val participants = message.participants
+            .map(::canonicalize)
+            .distinct()
+            .sorted()
+        val sender = message.sender?.let(::canonicalize)
+        return message.copy(
+            key = SyncMessageKeys.compute(
+                participants = participants,
+                outgoing = message.outgoing,
+                sender = sender,
+                sentTimestamp = message.sentTimestamp,
+                text = message.text,
+            ),
+            participants = participants,
+            sender = sender,
+        )
+    }
+
+    private fun uploadMedia(
+        client: WebDavClient,
+        fileUrl: String,
+        snapshot: SyncSnapshot,
+    ): Int {
+        var uploaded = 0
+        for ((remoteName, media) in snapshot.mediaByRemoteName) {
+            val url = client.mediaUrl(fileUrl, remoteName)
+            if (client.exists(url)) {
+                continue
+            }
+            client.uploadFile(url, media.contentType) {
+                context.contentResolver.openInputStream(media.contentUri)
+            }
+            uploaded++
+        }
+        return uploaded
+    }
+
+    private fun extensionFor(contentType: String): String {
+        val extension = MimeTypeMap.getSingleton()
+            .getExtensionFromMimeType(contentType.substringBefore(';').trim())
+            ?.lowercase(Locale.US)
+            ?.filter(Char::isLetterOrDigit)
+            ?.takeIf { it.isNotEmpty() && it.length <= 8 }
+        return extension ?: DEFAULT_EXTENSION
+    }
+
+    private data class SnapshotRows(
+        val participants: Map<String, List<String>>,
+        val rows: List<SnapshotRow>,
+    )
+
+    private data class SnapshotRow(
+        val messageId: String,
+        val conversationId: String?,
+        val outgoing: Boolean,
+        val sender: String?,
+        val sentTimestamp: Long,
+        val receivedTimestamp: Long,
+        val subject: String?,
+        val seen: Boolean,
+        val read: Boolean,
+        val partText: String?,
+        val partUri: String?,
+        val partContentType: String?,
+        val partWidth: Int,
+        val partHeight: Int,
+    )
+
+    private class MessageBuilder(
+        val conversationId: String?,
+        val outgoing: Boolean,
+        val sender: String?,
+        val sentTimestamp: Long,
+        val receivedTimestamp: Long,
+        val subject: String?,
+        val seen: Boolean,
+        val read: Boolean,
+    ) {
+        val textParts = ArrayList<String>()
+        val media = ArrayList<MediaHash>()
+    }
+
+    private data class ImportPlan(
+        val message: SyncMessage,
+        val mediaUris: List<Uri>,
+    )
+
+    private data class DownloadResult(
+        val importable: List<ImportPlan>,
+        val skipped: List<SyncMessage>,
+        val downloadedMedia: Int,
+    )
+
+    private companion object {
+        const val DEFAULT_FILE_NAME = "messaging-sync.json"
+        const val DEFAULT_CONTENT_TYPE = "application/octet-stream"
+        const val DEFAULT_EXTENSION = "bin"
+        const val HASH_BUFFER_BYTES = 64 * 1024
+        const val MAX_MEDIA_BYTES = 200L * 1024 * 1024
+        const val FALLBACK_THREAD_ID_MASK = 0x3fff_ffff_ffff_ffffL
+
+        const val INDEX_MESSAGE_ID = 0
+        const val INDEX_CONVERSATION_ID = 1
+        const val INDEX_SENDER_ID = 2
+        const val INDEX_SELF_ID = 3
+        const val INDEX_SENT_TIMESTAMP = 4
+        const val INDEX_RECEIVED_TIMESTAMP = 5
+        const val INDEX_SUBJECT = 6
+        const val INDEX_SEEN = 7
+        const val INDEX_READ = 8
+        const val INDEX_SENDER_DESTINATION = 9
+        const val INDEX_PART_TEXT = 10
+        const val INDEX_PART_URI = 11
+        const val INDEX_PART_CONTENT_TYPE = 12
+        const val INDEX_PART_WIDTH = 13
+        const val INDEX_PART_HEIGHT = 14
+
+        val EXCLUDED_STATUSES = listOf(
+            MessageData.BUGLE_STATUS_OUTGOING_DRAFT,
+            MessageData.BUGLE_STATUS_INCOMING_YET_TO_MANUAL_DOWNLOAD,
+            MessageData.BUGLE_STATUS_INCOMING_RETRYING_MANUAL_DOWNLOAD,
+            MessageData.BUGLE_STATUS_INCOMING_MANUAL_DOWNLOADING,
+            MessageData.BUGLE_STATUS_INCOMING_RETRYING_AUTO_DOWNLOAD,
+            MessageData.BUGLE_STATUS_INCOMING_AUTO_DOWNLOADING,
+        ).joinToString(",")
+
+        val SNAPSHOT_QUERY = """
+            SELECT
+                m.${MessageColumns._ID},
+                m.${MessageColumns.CONVERSATION_ID},
+                m.${MessageColumns.SENDER_PARTICIPANT_ID},
+                m.${MessageColumns.SELF_PARTICIPANT_ID},
+                m.${MessageColumns.SENT_TIMESTAMP},
+                m.${MessageColumns.RECEIVED_TIMESTAMP},
+                m.${MessageColumns.MMS_SUBJECT},
+                m.${MessageColumns.SEEN},
+                m.${MessageColumns.READ},
+                sender.${ParticipantColumns.NORMALIZED_DESTINATION},
+                p.${PartColumns.TEXT},
+                p.${PartColumns.CONTENT_URI},
+                p.${PartColumns.CONTENT_TYPE},
+                p.${PartColumns.WIDTH},
+                p.${PartColumns.HEIGHT}
+            FROM ${DatabaseHelper.MESSAGES_TABLE} m
+            LEFT JOIN ${DatabaseHelper.PARTS_TABLE} p
+                ON p.${PartColumns.MESSAGE_ID} = m.${MessageColumns._ID}
+            LEFT JOIN ${DatabaseHelper.PARTICIPANTS_TABLE} sender
+                ON sender.${ParticipantColumns._ID} = m.${MessageColumns.SENDER_PARTICIPANT_ID}
+            WHERE m.${MessageColumns.STATUS} NOT IN ($EXCLUDED_STATUSES)
+            ORDER BY m.${MessageColumns._ID}, p.${PartColumns._ID}
+        """.trimIndent()
+
+        val PARTICIPANTS_QUERY = """
+            SELECT
+                cp.${ConversationParticipantsColumns.CONVERSATION_ID},
+                p.${ParticipantColumns.NORMALIZED_DESTINATION}
+            FROM ${DatabaseHelper.CONVERSATION_PARTICIPANTS_TABLE} cp
+            JOIN ${DatabaseHelper.PARTICIPANTS_TABLE} p
+                ON p.${ParticipantColumns._ID} =
+                    cp.${ConversationParticipantsColumns.PARTICIPANT_ID}
+            WHERE p.${ParticipantColumns.NORMALIZED_DESTINATION} IS NOT NULL
+                AND p.${ParticipantColumns.NORMALIZED_DESTINATION} != ''
+        """.trimIndent()
+    }
+}
