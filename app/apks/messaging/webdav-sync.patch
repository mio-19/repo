@@ -0,0 +1,118 @@
+package com.android.messaging.data.webdavsync
+
+import android.security.keystore.KeyGenParameterSpec
+import android.security.keystore.KeyProperties
+import android.util.Base64
+import java.security.KeyStore
+import javax.crypto.Cipher
+import javax.crypto.KeyGenerator
+import javax.crypto.SecretKey
+import javax.crypto.spec.GCMParameterSpec
+import javax.inject.Inject
+
+/**
+ * Encrypts the WebDAV password with a key that never leaves the Android Keystore.
+ *
+ * If the Keystore is unavailable the value is stored base64-encoded instead. That fallback keeps
+ * sync usable on devices with a broken Keystore, but it is not confidential.
+ */
+internal class WebDavCredentialCipher @Inject constructor() {
+
+    fun encrypt(value: String): String {
+        if (value.isEmpty()) {
+            return ""
+        }
+        return try {
+            val cipher = Cipher.getInstance(TRANSFORMATION)
+            cipher.init(Cipher.ENCRYPT_MODE, getOrCreateKey())
+            val initializationVector = cipher.iv
+            val encrypted = cipher.doFinal(value.toByteArray(Charsets.UTF_8))
+            val payload = ByteArray(1 + initializationVector.size + encrypted.size)
+            payload[0] = initializationVector.size.toByte()
+            initializationVector.copyInto(payload, destinationOffset = 1)
+            encrypted.copyInto(payload, destinationOffset = 1 + initializationVector.size)
+            PREFIX_ENCRYPTED + Base64.encodeToString(payload, Base64.NO_WRAP)
+        } catch (exception: Exception) {
+            PREFIX_PLAIN + Base64.encodeToString(
+                value.toByteArray(Charsets.UTF_8),
+                Base64.NO_WRAP,
+            )
+        }
+    }
+
+    fun decrypt(value: String): String {
+        if (value.isEmpty()) {
+            return ""
+        }
+        return when {
+            value.startsWith(PREFIX_ENCRYPTED) -> {
+                try {
+                    val payload = Base64.decode(value.removePrefix(PREFIX_ENCRYPTED), Base64.NO_WRAP)
+                    val initializationVectorSize = payload[0].toInt() and 0xff
+                    val initializationVector = payload.copyOfRange(
+                        1,
+                        1 + initializationVectorSize,
+                    )
+                    val encrypted = payload.copyOfRange(
+                        1 + initializationVectorSize,
+                        payload.size,
+                    )
+                    val cipher = Cipher.getInstance(TRANSFORMATION)
+                    cipher.init(
+                        Cipher.DECRYPT_MODE,
+                        getOrCreateKey(),
+                        GCMParameterSpec(GCM_TAG_BITS, initializationVector),
+                    )
+                    String(cipher.doFinal(encrypted), Charsets.UTF_8)
+                } catch (exception: Exception) {
+                    ""
+                }
+            }
+
+            value.startsWith(PREFIX_PLAIN) -> {
+                try {
+                    String(
+                        Base64.decode(value.removePrefix(PREFIX_PLAIN), Base64.NO_WRAP),
+                        Charsets.UTF_8,
+                    )
+                } catch (exception: Exception) {
+                    ""
+                }
+            }
+
+            // Tolerate values written by early builds, which were stored as plain text.
+            else -> value
+        }
+    }
+
+    private fun getOrCreateKey(): SecretKey {
+        val keyStore = KeyStore.getInstance(ANDROID_KEYSTORE).apply { load(null) }
+        (keyStore.getKey(KEY_ALIAS, null) as? SecretKey)?.let { return it }
+
+        val generator = KeyGenerator.getInstance(
+            KeyProperties.KEY_ALGORITHM_AES,
+            ANDROID_KEYSTORE,
+        )
+        generator.init(
+            KeyGenParameterSpec.Builder(
+                KEY_ALIAS,
+                KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT,
+            )
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .setKeySize(KEY_SIZE_BITS)
+                .build(),
+        )
+        return generator.generateKey()
+    }
+
+    private companion object {
+        const val ANDROID_KEYSTORE = "AndroidKeyStore"
+        const val KEY_ALIAS = "messaging_webdav_sync_password"
+        const val TRANSFORMATION = "AES/GCM/NoPadding"
+        const val KEY_SIZE_BITS = 256
+        const val GCM_TAG_BITS = 128
+        const val PREFIX_ENCRYPTED = "enc:"
+        const val PREFIX_PLAIN = "plain:"
+    }
+}
