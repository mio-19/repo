+++ b/src/com/android/messaging/data/webdavsync/WebDavSyncPayloadCodec.kt
@@ -0,0 +1,151 @@
+package com.android.messaging.data.webdavsync
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+internal object WebDavSyncPayloadCodec {
+    private const val FORMAT = "grapheneos-messaging-webdav"
+    private const val VERSION = 1
+    private val REMOTE_NAME = Regex("[A-Za-z0-9._-]{1,160}")
+
+    fun encode(messages: Collection<SyncMessage>): String {
+        val root = JSONObject()
+        root.put("format", FORMAT)
+        root.put("version", VERSION)
+        root.put("exportedAt", System.currentTimeMillis())
+
+        val encodedMessages = JSONArray()
+        messages
+            .sortedWith(compareBy({ it.sentTimestamp }, { it.key }))
+            .forEach { message ->
+                encodedMessages.put(
+                    JSONObject().apply {
+                        put("id", message.key)
+                        put(
+                            "conversation",
+                            JSONArray().apply {
+                                message.participants.forEach { participant ->
+                                    put(participant)
+                                }
+                            },
+                        )
+                        put("direction", if (message.outgoing) "out" else "in")
+                        put("sender", message.sender ?: JSONObject.NULL)
+                        put("timestamp", message.sentTimestamp)
+                        put("receivedTimestamp", message.receivedTimestamp)
+                        put("subject", message.subject ?: JSONObject.NULL)
+                        put("text", message.text)
+                        put("seen", message.seen)
+                        put("read", message.read)
+                        put(
+                            "media",
+                            JSONArray().apply {
+                                message.media.forEach { media ->
+                                    put(
+                                        JSONObject().apply {
+                                            put("remoteName", media.remoteName)
+                                            put("contentType", media.contentType)
+                                            put("width", media.width)
+                                            put("height", media.height)
+                                            put("size", media.size)
+                                        },
+                                    )
+                                }
+                            },
+                        )
+                    },
+                )
+            }
+        root.put("messages", encodedMessages)
+        return root.toString()
+    }
+
+    fun decode(json: String): List<SyncMessage> {
+        if (json.isBlank()) {
+            return emptyList()
+        }
+        val root = JSONObject(json)
+        if (root.optString("format") != FORMAT) {
+            throw IllegalArgumentException("Unrecognized WebDAV sync file")
+        }
+        val version = root.optInt("version", 0)
+        if (version > VERSION) {
+            throw IllegalArgumentException("Unsupported WebDAV sync file version $version")
+        }
+        val encodedMessages = root.optJSONArray("messages") ?: return emptyList()
+        val result = ArrayList<SyncMessage>(encodedMessages.length())
+        for (index in 0 until encodedMessages.length()) {
+            val encoded = encodedMessages.optJSONObject(index) ?: continue
+            val participants = encoded.optJSONArray("conversation")
+                ?.let { array ->
+                    (0 until array.length()).mapNotNull { participantIndex ->
+                        array.optString(participantIndex).takeIf(String::isNotBlank)
+                    }
+                }
+                .orEmpty()
+                .distinct()
+            if (participants.isEmpty()) {
+                continue
+            }
+
+            val outgoing = encoded.optString("direction") == "out"
+            val sender = encoded.optStringOrNull("sender")
+            val sentTimestamp = encoded.optLong("timestamp", 0L)
+            val receivedTimestamp = encoded.optLong("receivedTimestamp", sentTimestamp)
+            val text = encoded.optString("text", "")
+            val media = encoded.optJSONArray("media")
+                ?.let { array ->
+                    (0 until array.length()).mapNotNull { mediaIndex ->
+                        val encodedMedia = array.optJSONObject(mediaIndex) ?: return@mapNotNull null
+                        val remoteName = sanitizeRemoteName(encodedMedia.optString("remoteName"))
+                            ?: return@mapNotNull null
+                        SyncMedia(
+                            remoteName = remoteName,
+                            contentType = encodedMedia.optString(
+                                "contentType",
+                                DEFAULT_CONTENT_TYPE,
+                            ),
+                            width = encodedMedia.optInt("width", UNSPECIFIED_SIZE),
+                            height = encodedMedia.optInt("height", UNSPECIFIED_SIZE),
+                            size = encodedMedia.optLong("size", -1L),
+                        )
+                    }
+                }
+                .orEmpty()
+
+            result.add(
+                SyncMessage(
+                    key = SyncMessageKeys.compute(
+                        participants = participants,
+                        outgoing = outgoing,
+                        sender = sender,
+                        sentTimestamp = sentTimestamp,
+                        text = text,
+                    ),
+                    participants = participants,
+                    outgoing = outgoing,
+                    sender = sender,
+                    sentTimestamp = sentTimestamp,
+                    receivedTimestamp = receivedTimestamp,
+                    subject = encoded.optStringOrNull("subject"),
+                    text = text,
+                    seen = encoded.optBoolean("seen", true),
+                    read = encoded.optBoolean("read", true),
+                    media = media,
+                ),
+            )
+        }
+        return result
+    }
+
+    fun sanitizeRemoteName(name: String): String? {
+        return name.takeIf { REMOTE_NAME.matches(it) }
+    }
+
+    private fun JSONObject.optStringOrNull(key: String): String? {
+        return if (isNull(key)) null else optString(key).takeIf(String::isNotBlank)
+    }
+
+    private const val DEFAULT_CONTENT_TYPE = "application/octet-stream"
+    private const val UNSPECIFIED_SIZE = -1
+}
