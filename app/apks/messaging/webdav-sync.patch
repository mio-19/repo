+package com.android.messaging.data.webdavsync
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.SystemClock
+import dagger.hilt.android.qualifiers.ApplicationContext
+import javax.inject.Inject
+
+internal interface WebDavSyncScheduler {
+    fun schedule()
+    fun cancel()
+    fun rescheduleIfEnabled()
+}
+
+internal class WebDavSyncSchedulerImpl @Inject constructor(
+    @param:ApplicationContext private val context: Context,
+    private val preferences: WebDavSyncPreferences,
+) : WebDavSyncScheduler {
+
+    override fun schedule() {
+        val alarmManager = context.getSystemService(AlarmManager::class.java) ?: return
+        val pendingIntent = pendingIntent()
+        alarmManager.cancel(pendingIntent)
+        alarmManager.setAndAllowWhileIdle(
+            AlarmManager.ELAPSED_REALTIME_WAKEUP,
+            SystemClock.elapsedRealtime() + INTERVAL_MILLIS,
+            pendingIntent,
+        )
+    }
+
+    override fun cancel() {
+        context.getSystemService(AlarmManager::class.java)?.cancel(pendingIntent())
+    }
+
+    override fun rescheduleIfEnabled() {
+        if (preferences.isPeriodicSyncEnabled()) {
+            schedule()
+        } else {
+            cancel()
+        }
+    }
+
+    private fun pendingIntent(): PendingIntent {
+        val intent = Intent(context, WebDavSyncReceiver::class.java)
+            .setAction(WebDavSyncReceiver.ACTION_SYNC)
+        return PendingIntent.getBroadcast(
+            context,
+            REQUEST_CODE,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+    }
+
+    private companion object {
+        const val REQUEST_CODE = 42
+        const val INTERVAL_MILLIS = 6L * 60L * 60L * 1000L
+    }
+}
