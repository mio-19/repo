@@ -0,0 +1,104 @@
+package com.android.messaging.data.webdavsync
+
+import android.net.Uri
+import java.security.MessageDigest
+
+internal data class WebDavSyncSettings(
+    val fileUrl: String = "",
+    val username: String = "",
+    val password: String = "",
+    val periodicSyncEnabled: Boolean = false,
+) {
+    val isConfigured: Boolean
+        get() = fileUrl.isNotBlank()
+}
+
+internal sealed interface WebDavSyncResult {
+    data class Success(
+        val importedMessages: Int,
+        val uploadedMessages: Int,
+        val downloadedMedia: Int,
+        val uploadedMedia: Int,
+        val skippedMessages: Int,
+    ) : WebDavSyncResult
+
+    data class Failure(
+        val reason: String,
+    ) : WebDavSyncResult
+}
+
+internal data class SyncMedia(
+    val remoteName: String,
+    val contentType: String,
+    val width: Int,
+    val height: Int,
+    val size: Long,
+)
+
+internal data class SyncMessage(
+    val key: String,
+    val participants: List<String>,
+    val outgoing: Boolean,
+    val sender: String?,
+    val sentTimestamp: Long,
+    val receivedTimestamp: Long,
+    val subject: String?,
+    val text: String,
+    val seen: Boolean,
+    val read: Boolean,
+    val media: List<SyncMedia>,
+)
+
+internal data class LocalMedia(
+    val contentUri: Uri,
+    val contentType: String,
+    val width: Int,
+    val height: Int,
+    val size: Long,
+)
+
+internal data class SyncSnapshot(
+    val messages: List<SyncMessage>,
+    val mediaByRemoteName: Map<String, LocalMedia>,
+)
+
+internal data class MediaHash(
+    val remoteName: String,
+    val media: LocalMedia,
+)
+
+internal object SyncMessageKeys {
+    fun compute(
+        participants: List<String>,
+        outgoing: Boolean,
+        sender: String?,
+        sentTimestamp: Long,
+        text: String,
+    ): String {
+        val canonical = buildString {
+            append(participants.sorted().joinToString(SEPARATOR))
+            append(SEPARATOR)
+            append(if (outgoing) "out" else "in")
+            append(SEPARATOR)
+            append(sender.orEmpty())
+            append(SEPARATOR)
+            append(sentTimestamp)
+            append(SEPARATOR)
+            append(text)
+        }
+        return toHex(
+            MessageDigest.getInstance("SHA-256")
+                .digest(canonical.toByteArray(Charsets.UTF_8)),
+        )
+    }
+
+    fun toHex(bytes: ByteArray): String = buildString(bytes.size * 2) {
+        for (byte in bytes) {
+            append(HEX[(byte.toInt() shr 4) and 0x0f])
+            append(HEX[byte.toInt() and 0x0f])
+        }
+    }
+
+    private const val SEPARATOR = "\u0000"
+    private const val HEX = "0123456789abcdef"
+}
diff --git a/src/com/android/messaging/data/webdavsync/WebDavSyncPayloadCodec.kt b/src/com/android/messaging/data/webdavsync/WebDavSyncPayloadCodec.kt
