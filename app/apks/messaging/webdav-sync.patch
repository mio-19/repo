+    /**
+     * Create a message imported by the WebDAV sync feature.
+     *
+     * The message is local-only: it deliberately has no SMS/MMS provider URI, so the periodic
+     * telephony sync does not try to match it against (or delete it from) the system databases.
+     */
+    public static MessageData createSyncedMessage(final String participantId, final String selfId,
+            final String conversationId, final boolean outgoing, final boolean seen,
+            final boolean read, final long sent, final long received, final String messageText) {
+        final MessageData message = new MessageData();
+        message.mParticipantId = participantId;
+        message.mSelfId = selfId;
+        message.mConversationId = conversationId;
+        message.mSentTimestamp = sent;
+        message.mReceivedTimestamp = received;
+        message.mSeen = seen;
+        message.mRead = read;
+        message.mProtocol = PROTOCOL_SMS;
+        message.mStatus = outgoing
+                ? BUGLE_STATUS_OUTGOING_COMPLETE
+                : BUGLE_STATUS_INCOMING_COMPLETE;
+        message.mSmsMessageUri = null;
+        message.mParts.add(TextUtils.isEmpty(messageText)
+                ? MessagePartData.createEmptyMessagePart()
+                : MessagePartData.createTextMessagePart(messageText));
+        return message;
+    }
