@@ -0,0 +1,23 @@
+package com.android.messaging.data.webdavsync
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import com.android.messaging.di.webdavsync.WebDavSyncEntryPoint
+import dagger.hilt.android.EntryPointAccessors
+
+internal class WebDavSyncBootReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_BOOT_COMPLETED &&
+            intent.action != Intent.ACTION_MY_PACKAGE_REPLACED
+        ) {
+            return
+        }
+
+        EntryPointAccessors.fromApplication(
+            context.applicationContext,
+            WebDavSyncEntryPoint::class.java,
+        ).webDavSyncScheduler().rescheduleIfEnabled()
+    }
+}
