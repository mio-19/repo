+package com.android.messaging.ui.appsettings.webdavsync
+
+import android.content.Context
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.android.messaging.R
+import com.android.messaging.data.webdavsync.WebDavSyncRepository
+import com.android.messaging.data.webdavsync.WebDavSyncScheduler
+import com.android.messaging.data.webdavsync.WebDavSyncSettings
+import com.android.messaging.ui.appsettings.webdavsync.model.WebDavSyncAction
+import com.android.messaging.ui.appsettings.webdavsync.model.WebDavSyncUiState
+import dagger.hilt.android.lifecycle.HiltViewModel
+import dagger.hilt.android.qualifiers.ApplicationContext
+import javax.inject.Inject
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+@HiltViewModel
+internal class WebDavSyncViewModel @Inject constructor(
+    private val repository: WebDavSyncRepository,
+    private val scheduler: WebDavSyncScheduler,
+    @param:ApplicationContext private val context: Context,
+) : ViewModel() {
+
+    private val _uiState = MutableStateFlow(WebDavSyncUiState())
+    val uiState: StateFlow<WebDavSyncUiState> = _uiState.asStateFlow()
+
+    init {
+        viewModelScope.launch {
+            val settings = repository.loadSettings()
+            _uiState.value = WebDavSyncUiState(
+                fileUrl = settings.fileUrl,
+                username = settings.username,
+                password = settings.password,
+                periodicSyncEnabled = settings.periodicSyncEnabled,
+                status = repository.lastStatus(),
+                lastSyncTime = repository.lastSyncTime(),
+                isLoading = false,
+            )
+        }
+    }
+
+    fun onAction(action: WebDavSyncAction) {
+        when (action) {
+            is WebDavSyncAction.FileUrlChanged -> {
+                _uiState.update { it.copy(fileUrl = action.value) }
+            }
+
+            is WebDavSyncAction.UsernameChanged -> {
+                _uiState.update { it.copy(username = action.value) }
+            }
+
+            is WebDavSyncAction.PasswordChanged -> {
+                _uiState.update { it.copy(password = action.value) }
+            }
+
+            is WebDavSyncAction.PeriodicSyncChanged -> {
+                _uiState.update { it.copy(periodicSyncEnabled = action.enabled) }
+            }
+
+            is WebDavSyncAction.SaveClicked -> save(showConfirmation = true)
+            is WebDavSyncAction.SyncClicked -> sync()
+        }
+    }
+
+    private fun save(showConfirmation: Boolean) {
+        val settings = _uiState.value.toSettings()
+        viewModelScope.launch {
+            repository.saveSettings(settings)
+            applyScheduling(settings)
+            if (showConfirmation) {
+                _uiState.update {
+                    it.copy(status = context.getString(R.string.webdav_sync_saved))
+                }
+            }
+        }
+    }
+
+    private fun sync() {
+        if (_uiState.value.isSyncing) {
+            return
+        }
+        val settings = _uiState.value.toSettings()
+        viewModelScope.launch {
+            repository.saveSettings(settings)
+            applyScheduling(settings)
+            _uiState.update { it.copy(isSyncing = true) }
+            repository.sync()
+            _uiState.update {
+                it.copy(
+                    isSyncing = false,
+                    status = repository.lastStatus(),
+                    lastSyncTime = repository.lastSyncTime(),
+                )
+            }
+        }
+    }
+
+    private fun applyScheduling(settings: WebDavSyncSettings) {
+        if (settings.periodicSyncEnabled && settings.isConfigured) {
+            scheduler.schedule()
+        } else {
+            scheduler.cancel()
+        }
+    }
+
+    private fun WebDavSyncUiState.toSettings(): WebDavSyncSettings {
+        return WebDavSyncSettings(
+            fileUrl = fileUrl,
+            username = username,
+            password = password,
+            periodicSyncEnabled = periodicSyncEnabled,
+        )
+    }
+}
