+package com.android.messaging.data.webdavsync
+
+import android.content.Context
+import com.android.messaging.util.BuglePrefs
+import dagger.hilt.android.qualifiers.ApplicationContext
+import javax.inject.Inject
+
+internal class WebDavSyncPreferences @Inject constructor(
+    @param:ApplicationContext context: Context,
+    private val cipher: WebDavCredentialCipher,
+) {
+    private val preferences = context.getSharedPreferences(
+        BuglePrefs.SHARED_PREFERENCES_NAME,
+        Context.MODE_PRIVATE,
+    )
+
+    fun load(): WebDavSyncSettings {
+        return WebDavSyncSettings(
+            fileUrl = preferences.getString(KEY_FILE_URL, "").orEmpty(),
+            username = preferences.getString(KEY_USERNAME, "").orEmpty(),
+            password = cipher.decrypt(preferences.getString(KEY_PASSWORD, "").orEmpty()),
+            periodicSyncEnabled = preferences.getBoolean(KEY_PERIODIC_SYNC, false),
+        )
+    }
+
+    fun save(settings: WebDavSyncSettings) {
+        preferences.edit()
+            .putString(KEY_FILE_URL, settings.fileUrl)
+            .putString(KEY_USERNAME, settings.username)
+            .putString(KEY_PASSWORD, cipher.encrypt(settings.password))
+            .putBoolean(KEY_PERIODIC_SYNC, settings.periodicSyncEnabled)
+            .apply()
+    }
+
+    fun lastSyncTime(): Long {
+        return preferences.getLong(KEY_LAST_SYNC_TIME, 0L)
+    }
+
+    fun isPeriodicSyncEnabled(): Boolean {
+        return preferences.getBoolean(KEY_PERIODIC_SYNC, false) &&
+            !preferences.getString(KEY_FILE_URL, "").isNullOrBlank()
+    }
+
+    fun lastStatus(): String {
+        return preferences.getString(KEY_LAST_STATUS, "").orEmpty()
+    }
+
+    fun saveLastSync(time: Long, status: String) {
+        preferences.edit()
+            .putLong(KEY_LAST_SYNC_TIME, time)
+            .putString(KEY_LAST_STATUS, status)
+            .apply()
+    }
+
+    private companion object {
+        const val KEY_FILE_URL = "webdav_sync_file_url"
+        const val KEY_USERNAME = "webdav_sync_username"
+        const val KEY_PASSWORD = "webdav_sync_password"
+        const val KEY_PERIODIC_SYNC = "webdav_sync_periodic"
+        const val KEY_LAST_SYNC_TIME = "webdav_sync_last_sync_time"
+        const val KEY_LAST_STATUS = "webdav_sync_last_status"
+    }
+}
