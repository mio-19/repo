+
+    @Override
+    public PendingIntent getPendingIntentForCopyingVerificationCode(
+            Context context, String conversationId, String verificationCode) {
+        final Intent intent = new Intent(context, com.android.messaging.receiver.CopyVerificationCodeReceiver.class);
+        intent.setAction(com.android.messaging.receiver.CopyVerificationCodeReceiver.ACTION_COPY_VERIFICATION_CODE);
+        intent.putExtra(UI_INTENT_EXTRA_CONVERSATION_ID, conversationId);
+        intent.putExtra(com.android.messaging.receiver.CopyVerificationCodeReceiver.EXTRA_VERIFICATION_CODE, verificationCode);
+        intent.setIdentifier(conversationId + ":" + verificationCode);
+        return PendingIntent.getBroadcast(context, 0, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+    }
 }
