diff --git a/src/com/android/messaging/util/VerificationCodeUtil.kt b/src/com/android/messaging/util/VerificationCodeUtil.kt
new file mode 100644
index 0000000..44badf2
--- /dev/null
+++ b/src/com/android/messaging/util/VerificationCodeUtil.kt
@@ -0,0 +1,131 @@
+package com.android.messaging.util
+
+import java.util.regex.Pattern
+
+object VerificationCodeUtil {
+
+    // Common verification/OTP trigger keywords across multiple languages
+    private val TRIGGER_KEYWORD_PATTERN = Pattern.compile(
+        "(?i)\\b(?:" +
+            // English
+            "code|otp|pin|passcode|password|verification|verify|verifying|auth|authenticate|authentication|security|secret|confirm|confirmation|login|access" +
+            // Spanish & Portuguese
+            "|c[oó]digo|c[oó]digos|verificaci[oó]n|verificar|autentica[cç][aã]o|confirma[cç][aã]o|seguran[cç]a|seguridad|clave" +
+            // French
+            "|v[eé]rification|v[eé]rifier|authentification|confirmation|s[eé]curit[eé]" +
+            // German
+            "|sicherheitscode|best[aä]tigungscode|verifizierung|best[aä]tigen" +
+            // Italian
+            "|codice|verifica|autenticazione|conferma|sicurezza" +
+            // Russian
+            "|код|пароль|верификац|подтвержд" +
+            // Chinese / Japanese
+            "|验证码|驗證碼|动态码|動態碼|认证码|認證碼|校验码|認証コード|確認コード" +
+            ")\\b",
+        Pattern.CASE_INSENSITIVE or Pattern.UNICODE_CASE,
+    )
+
+    // Direct match pattern: keyword followed by optional words/separators and then code
+    // Example: "code is 123456", "OTP: 9876", "código: 54321", "verification code: G-123456"
+    private val DIRECT_CODE_PATTERN = Pattern.compile(
+        "(?i)(?:code|otp|pin|passcode|password|c[oó]digo|codice|clave|код|验证码|驗證碼|認証コード|確認コード)" +
+            "[^0-9a-zA-Z]{0,15}?" +
+            "(?:is|ist|est|es|para|de|for|=|:|-|#)?\\s*" +
+            "([A-Za-z0-9]{1,3}[- ]?\\d{4,8}|\\b\\d{4,8}\\b)",
+        Pattern.CASE_INSENSITIVE or Pattern.UNICODE_CASE,
+    )
+
+    // Prefix patterns like G-123456 (Google)
+    private val PREFIX_CODE_PATTERN = Pattern.compile(
+        "(?i)\\b([A-Za-z]-?\\d{4,8})\\b",
+    )
+
+    // Hyphenated/spaced digits like 123-456 or 123 456
+    private val HYPHENATED_CODE_PATTERN = Pattern.compile(
+        "\\b(\\d{3,4})[- ](\\d{3,4})\\b",
+    )
+
+    // Standalone 4 to 8 digit numbers
+    private val STANDALONE_DIGITS_PATTERN = Pattern.compile(
+        "\\b\\d{4,8}\\b",
+    )
+
+    /**
+     * Extracts a verification code / OTP from the given message text if present.
+     * Returns null if no verification code is detected or if text does not look like a verification message.
+     */
+    @JvmStatic
+    fun extractVerificationCode(text: CharSequence?): String? {
+        if (text.isNullOrBlank()) return null
+        val message = text.toString()
+
+        // 1. Must contain at least one verification trigger keyword
+        if (!TRIGGER_KEYWORD_PATTERN.matcher(message).find()) {
+            return null
+        }
+
+        // 2. Try direct pattern after keyword (highest confidence)
+        val directMatcher = DIRECT_CODE_PATTERN.matcher(message)
+        if (directMatcher.find()) {
+            val candidate = directMatcher.group(1)?.trim()
+            if (!candidate.isNullOrEmpty()) {
+                val clean = normalizeCode(candidate)
+                if (isValidCode(clean)) return clean
+            }
+        }
+
+        // 3. Try prefix pattern (e.g. G-123456)
+        val prefixMatcher = PREFIX_CODE_PATTERN.matcher(message)
+        while (prefixMatcher.find()) {
+            val candidate = prefixMatcher.group(1)?.trim()
+            if (!candidate.isNullOrEmpty()) {
+                val clean = normalizeCode(candidate)
+                if (isValidCode(clean)) return clean
+            }
+        }
+
+        // 4. Try hyphenated pattern (e.g. 123-456)
+        val hyphenMatcher = HYPHENATED_CODE_PATTERN.matcher(message)
+        while (hyphenMatcher.find()) {
+            val p1 = hyphenMatcher.group(1)
+            val p2 = hyphenMatcher.group(2)
+            if (p1 != null && p2 != null) {
+                val combined = p1 + p2
+                if (isValidCode(combined)) return combined
+            }
+        }
+
+        // 5. Try standalone digits (filter out obvious years like 1990..2040 if others exist)
+        val standaloneMatcher = STANDALONE_DIGITS_PATTERN.matcher(message)
+        var fallbackCandidate: String? = null
+        while (standaloneMatcher.find()) {
+            val candidate = standaloneMatcher.group()
+            if (isValidCode(candidate)) {
+                val num = candidate.toIntOrNull()
+                if (candidate.length == 4 && num != null && num in 1990..2040) {
+                    if (fallbackCandidate == null) fallbackCandidate = candidate
+                } else {
+                    return candidate
+                }
+            }
+        }
+
+        return fallbackCandidate
+    }
+
+    private fun normalizeCode(code: String): String {
+        // If code is like "G-123456" or "g-123456", strip the letter prefix if digits follow
+        if (code.length >= 5 && code[1] == '-' && code[0].isLetter()) {
+            return code.substring(2)
+        }
+        // If code has space or hyphen e.g. "123-456" -> "123456"
+        return code.replace("-", "").replace(" ", "")
+    }
+
+    private fun isValidCode(code: String): Boolean {
+        // Valid code is 4 to 8 alphanumeric/digit characters, predominantly digits
+        if (code.length !in 4..8) return false
+        val digitCount = code.count { it.isDigit() }
+        return digitCount >= 4
+    }
+}
