@@ -0,0 +1,52 @@
+package com.android.messaging.receiver;
+
+import android.content.BroadcastReceiver;
+import android.content.ClipData;
+import android.content.ClipDescription;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.os.PersistableBundle;
+import android.widget.Toast;
+
+import com.android.messaging.R;
+import com.android.messaging.datamodel.action.MarkAsReadAction;
+import com.android.messaging.ui.UIIntents;
+
+public class CopyVerificationCodeReceiver extends BroadcastReceiver {
+    public static final String ACTION_COPY_VERIFICATION_CODE = "com.android.messaging.receiver.COPY_VERIFICATION_CODE";
+    public static final String EXTRA_VERIFICATION_CODE = "verification_code";
+
+    @Override
+    public void onReceive(final Context context, final Intent intent) {
+        if (ACTION_COPY_VERIFICATION_CODE.equals(intent.getAction())) {
+            final String code = intent.getStringExtra(EXTRA_VERIFICATION_CODE);
+            if (code == null) {
+                return;
+            }
+            final String conversationId = intent.getStringExtra(UIIntents.UI_INTENT_EXTRA_CONVERSATION_ID);
+
+            final ClipboardManager clipboard = (ClipboardManager) context.getSystemService(Context.CLIPBOARD_SERVICE);
+            if (clipboard != null) {
+                final ClipData clip = ClipData.newPlainText(context.getString(R.string.verification_code_label), code);
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                    final PersistableBundle bundle = new PersistableBundle();
+                    bundle.putBoolean(ClipDescription.EXTRA_IS_SENSITIVE, true);
+                    clip.getDescription().setExtras(bundle);
+                }
+                clipboard.setPrimaryClip(clip);
+            }
+
+            Toast.makeText(
+                context,
+                context.getString(R.string.verification_code_copied_toast, code),
+                Toast.LENGTH_SHORT
+            ).show();
+
+            if (conversationId != null && !conversationId.isEmpty()) {
+                MarkAsReadAction.markAsRead(conversationId, true);
+            }
+        }
+    }
+}
