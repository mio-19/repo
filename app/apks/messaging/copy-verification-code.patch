diff --git a/src/com/android/messaging/receiver/CopyVerificationCodeReceiver.kt b/src/com/android/messaging/receiver/CopyVerificationCodeReceiver.kt
new file mode 100644
index 0000000..d04ba89
--- /dev/null
+++ b/src/com/android/messaging/receiver/CopyVerificationCodeReceiver.kt
@@ -0,0 +1,49 @@
+package com.android.messaging.receiver
+
+import android.content.BroadcastReceiver
+import android.content.ClipData
+import android.content.ClipDescription
+import android.content.ClipboardManager
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.PersistableBundle
+import android.widget.Toast
+import com.android.messaging.R
+import com.android.messaging.datamodel.action.MarkAsReadAction
+import com.android.messaging.ui.UIIntents
+
+class CopyVerificationCodeReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action == ACTION_COPY_VERIFICATION_CODE) {
+            val code = intent.getStringExtra(EXTRA_VERIFICATION_CODE) ?: return
+            val conversationId = intent.getStringExtra(UIIntents.UI_INTENT_EXTRA_CONVERSATION_ID)
+
+            val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as? ClipboardManager
+            if (clipboard != null) {
+                val clip = ClipData.newPlainText(context.getString(R.string.verification_code_label), code)
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                    clip.description.extras = PersistableBundle().apply {
+                        putBoolean(ClipDescription.EXTRA_IS_SENSITIVE, true)
+                    }
+                }
+                clipboard.setPrimaryClip(clip)
+            }
+
+            Toast.makeText(
+                context,
+                context.getString(R.string.verification_code_copied_toast, code),
+                Toast.LENGTH_SHORT,
+            ).show()
+
+            if (!conversationId.isNullOrEmpty()) {
+                MarkAsReadAction.markAsRead(conversationId, true)
+            }
+        }
+    }
+
+    companion object {
+        const val ACTION_COPY_VERIFICATION_CODE = "com.android.messaging.receiver.COPY_VERIFICATION_CODE"
+        const val EXTRA_VERIFICATION_CODE = "verification_code"
+    }
+}
