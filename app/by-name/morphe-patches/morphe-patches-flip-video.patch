@@ -0,0 +1,257 @@
+/*
+ * Copyright 2026 Morphe.
+ *
+ * See the included NOTICE file for GPLv3 Section 7 terms that apply to this code.
+ */
+
+package app.morphe.extension.youtube.videoplayer;
+
+import static app.morphe.extension.shared.StringRef.str;
+
+import android.app.Activity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.widget.ImageView;
+
+import androidx.annotation.Nullable;
+
+import java.lang.ref.WeakReference;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.youtube.patches.FullscreenVideoScalePatch;
+import app.morphe.extension.youtube.patches.LegacyPlayerControlsPatch;
+import app.morphe.extension.youtube.settings.Settings;
+import app.morphe.extension.youtube.shared.PlayerType;
+import kotlin.Unit;
+
+@SuppressWarnings("unused")
+public class FlipVideoButton {
+
+    @Nullable
+    private static LegacyPlayerControlButton legacy;
+
+    private static WeakReference<ImageView> overlayButtonRef = new WeakReference<>(null);
+    private static WeakReference<View> playerViewRef = new WeakReference<>(null);
+
+    private static volatile boolean isFlipped = false;
+
+    static {
+        PlayerType.getOnChange().addObserver((PlayerType type) -> {
+            if (isFlipped) {
+                applyFlip();
+            }
+            return Unit.INSTANCE;
+        });
+    }
+
+    public static boolean isFlipped() {
+        return isFlipped;
+    }
+
+    public static void setFlipped(boolean flipped) {
+        if (isFlipped == flipped) return;
+        isFlipped = flipped;
+        updateButtonIcon();
+        applyFlip();
+    }
+
+    /**
+     * Injection point.
+     */
+    public static void initializeButton(View controlsView) {
+        try {
+            if (LegacyPlayerControlsPatch.RESTORE_OLD_PLAYER_BUTTONS
+                    || !Settings.FLIP_VIDEO_BUTTON.get()) {
+                return;
+            }
+
+            ImageView added = PlayerOverlayButton.addButton(
+                    controlsView,
+                    getIconName(),
+                    FlipVideoButton::isOverlayButtonEnabled,
+                    view -> toggleFlip(),
+                    null
+            );
+            overlayButtonRef = new WeakReference<>(added);
+        } catch (Exception ex) {
+            Logger.printException(() -> "FlipVideoButton.initializeButton failure", ex);
+        }
+    }
+
+    /**
+     * Injection point.
+     */
+    public static void initializeLegacyButton(View controlsView) {
+        try {
+            if (!LegacyPlayerControlsPatch.RESTORE_OLD_PLAYER_BUTTONS) {
+                return;
+            }
+
+            legacy = new LegacyPlayerControlButton(
+                    controlsView,
+                    "morphe_flip_video_button",
+                    null,
+                    getIconBaseName(),
+                    () -> isOverlayButtonEnabled()
+                            ? LegacyPlayerControlButton.ButtonVisibility.ENABLED
+                            : LegacyPlayerControlButton.ButtonVisibility.DISABLED,
+                    view -> toggleFlip(),
+                    null
+            );
+        } catch (Exception ex) {
+            Logger.printException(() -> "FlipVideoButton.initializeLegacyButton failure", ex);
+        }
+    }
+
+    /**
+     * Injection point.
+     * Reset flip when a new video starts if remembering flip state is not enabled.
+     */
+    public static void resetFlipButton() {
+        if (!isFlipped || Settings.FLIP_VIDEO_REMEMBER.get()) {
+            return;
+        }
+
+        Utils.runOnMainThread(() -> {
+            try {
+                isFlipped = false;
+                updateButtonIcon();
+                applyFlip();
+            } catch (Exception ex) {
+                Logger.printException(() -> "resetFlipButton failure", ex);
+            }
+        });
+    }
+
+    public static void onPlayerViewLayout(View playerView) {
+        if (playerView == null) {
+            return;
+        }
+        playerViewRef = new WeakReference<>(playerView);
+        if (isFlipped) {
+            applyFlip();
+        }
+    }
+
+    private static boolean isOverlayButtonEnabled() {
+        if (!Settings.FLIP_VIDEO_BUTTON.get()) {
+            return false;
+        }
+        if (!Settings.FLIP_VIDEO_BUTTON_FULLSCREEN_ONLY.get()) {
+            return true;
+        }
+        PlayerType type = PlayerType.getCurrent();
+        return type == PlayerType.WATCH_WHILE_FULLSCREEN
+                || type == PlayerType.WATCH_WHILE_SLIDING_MAXIMIZED_FULLSCREEN;
+    }
+
+    private static void toggleFlip() {
+        try {
+            isFlipped = !isFlipped;
+            updateButtonIcon();
+            applyFlip();
+            Utils.showToastShort(str(isFlipped
+                    ? "morphe_flip_video_toast_on"
+                    : "morphe_flip_video_toast_off"));
+        } catch (Exception ex) {
+            Logger.printException(() -> "toggleFlip failure", ex);
+        }
+    }
+
+    public static void applyFlip() {
+        Utils.runOnMainThread(() -> {
+            try {
+                if (FullscreenVideoScalePatch.shouldScale()
+                        && Settings.FULLSCREEN_VIDEO_SCALE.get() != FullscreenVideoScalePatch.VideoScaleMode.DEFAULT) {
+                    FullscreenVideoScalePatch.applyScale();
+                    return;
+                }
+
+                View view = resolvePlayerView();
+                if (view == null) {
+                    return;
+                }
+
+                final int w = view.getWidth();
+                final int h = view.getHeight();
+                if (w > 0 && h > 0) {
+                    view.setPivotX(w / 2f);
+                    view.setPivotY(h / 2f);
+                }
+                view.setScaleX(isFlipped ? -1.0f : 1.0f);
+            } catch (Exception ex) {
+                Logger.printException(() -> "applyFlip failure", ex);
+            }
+        });
+    }
+
+    private static void updateButtonIcon() {
+        Utils.verifyOnMainThread();
+
+        final int icon = PlayerIcons.id(getIconBaseName());
+
+        ImageView overlayButton = overlayButtonRef.get();
+        if (overlayButton != null) {
+            overlayButton.setImageResource(icon);
+        }
+
+        if (legacy != null) {
+            legacy.setIcon(icon);
+        }
+    }
+
+    private static String getIconName() {
+        return PlayerIcons.name(getIconBaseName());
+    }
+
+    private static String getIconBaseName() {
+        return isFlipped
+                ? "morphe_flip_video_button_on"
+                : "morphe_flip_video_button_off";
+    }
+
+    @Nullable
+    private static View resolvePlayerView() {
+        View cached = playerViewRef.get();
+        if (cached != null && cached.isAttachedToWindow() && cached.getWidth() > 0) {
+            return cached;
+        }
+
+        Activity activity = Utils.getActivity();
+        if (activity != null) {
+            Window window = activity.getWindow();
+            if (window != null) {
+                View found = findPlayerView(window.getDecorView(), 0);
+                if (found != null) {
+                    playerViewRef = new WeakReference<>(found);
+                    return found;
+                }
+            }
+        }
+        return cached;
+    }
+
+    @Nullable
+    private static View findPlayerView(View view, int depth) {
+        if (depth > 18 || view == null) {
+            return null;
+        }
+        String name = view.getClass().getName();
+        if (name.endsWith("YouTubePlayerViewNotForReflection")
+                || name.endsWith("player.ui.PlayerView")) {
+            return view;
+        }
+        if (!(view instanceof ViewGroup group)) {
+            return null;
+        }
+        for (int i = 0, n = group.getChildCount(); i < n; i++) {
+            View found = findPlayerView(group.getChildAt(i), depth + 1);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+}
