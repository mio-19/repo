@@ -0,0 +1,529 @@
+/*
+ * Copyright 2026 Morphe.
+ *
+ * See the included NOTICE file for GPLv3 Section 7 terms that apply to this code.
+ */
+
+package app.morphe.extension.youtube.videoplayer;
+
+import static app.morphe.extension.shared.StringRef.str;
+
+import android.app.Activity;
+import android.graphics.Rect;
+import android.os.Build;
+import android.view.SurfaceControl;
+import android.view.SurfaceHolder;
+import android.view.SurfaceView;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.view.ViewTreeObserver;
+import android.view.Window;
+import android.widget.ImageView;
+
+import androidx.annotation.Nullable;
+import androidx.annotation.RequiresApi;
+
+import java.lang.ref.WeakReference;
+import java.lang.reflect.Method;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.youtube.patches.LegacyPlayerControlsPatch;
+import app.morphe.extension.youtube.settings.Settings;
+import app.morphe.extension.youtube.shared.PlayerType;
+import kotlin.Unit;
+
+@SuppressWarnings("unused")
+public class FlipVideoButton {
+
+    @Nullable
+    private static LegacyPlayerControlButton legacy;
+
+    private static WeakReference<ImageView> overlayButtonRef = new WeakReference<>(null);
+    private static WeakReference<View> playerViewRef = new WeakReference<>(null);
+    private static WeakReference<SurfaceView> videoSurfaceRef = new WeakReference<>(null);
+
+    private static volatile boolean isFlipped = false;
+    private static boolean playerViewFlipped;
+
+    private static WeakReference<View> mirrorHostRef = new WeakReference<>(null);
+    private static boolean mirrorListenerAttached;
+    @Nullable
+    private static ViewTreeObserver.OnPreDrawListener mirrorListener;
+
+    static {
+        PlayerType.getOnChange().addObserver((PlayerType type) -> {
+            if (isFlipped) {
+                applyFlip();
+            }
+            return Unit.INSTANCE;
+        });
+    }
+
+    public static boolean isFlipped() {
+        return isFlipped;
+    }
+
+    public static void setFlipped(boolean flipped) {
+        if (isFlipped == flipped) return;
+        isFlipped = flipped;
+        updateButtonIcon();
+        applyFlip();
+    }
+
+    /**
+     * Injection point.
+     */
+    public static void initializeButton(View controlsView) {
+        try {
+            if (LegacyPlayerControlsPatch.RESTORE_OLD_PLAYER_BUTTONS
+                    || !Settings.FLIP_VIDEO_BUTTON.get()) {
+                return;
+            }
+
+            ImageView added = PlayerOverlayButton.addButton(
+                    controlsView,
+                    getIconName(),
+                    FlipVideoButton::isOverlayButtonEnabled,
+                    view -> toggleFlip(),
+                    null
+            );
+            overlayButtonRef = new WeakReference<>(added);
+        } catch (Exception ex) {
+            Logger.printException(() -> "FlipVideoButton.initializeButton failure", ex);
+        }
+    }
+
+    /**
+     * Injection point.
+     */
+    public static void initializeLegacyButton(View controlsView) {
+        try {
+            if (!LegacyPlayerControlsPatch.RESTORE_OLD_PLAYER_BUTTONS) {
+                return;
+            }
+
+            legacy = new LegacyPlayerControlButton(
+                    controlsView,
+                    "morphe_flip_video_button",
+                    null,
+                    getIconBaseName(),
+                    () -> isOverlayButtonEnabled()
+                            ? LegacyPlayerControlButton.ButtonVisibility.ENABLED
+                            : LegacyPlayerControlButton.ButtonVisibility.DISABLED,
+                    view -> toggleFlip(),
+                    null
+            );
+        } catch (Exception ex) {
+            Logger.printException(() -> "FlipVideoButton.initializeLegacyButton failure", ex);
+        }
+    }
+
+    /**
+     * Injection point.
+     * Reset flip when a new video starts if remembering flip state is not enabled.
+     */
+    public static void resetFlipButton() {
+        if (!isFlipped || Settings.FLIP_VIDEO_REMEMBER.get()) {
+            return;
+        }
+
+        Utils.runOnMainThread(() -> {
+            try {
+                isFlipped = false;
+                updateButtonIcon();
+                applyFlip();
+            } catch (Exception ex) {
+                Logger.printException(() -> "resetFlipButton failure", ex);
+            }
+        });
+    }
+
+    public static void onPlayerViewLayout(View playerView) {
+        if (playerView == null) {
+            return;
+        }
+        if (playerViewRef.get() != playerView) {
+            // A different player was laid out, so the cached video surface is stale.
+            videoSurfaceRef = new WeakReference<>(null);
+        }
+        playerViewRef = new WeakReference<>(playerView);
+        if (isFlipped) {
+            applyFlip();
+        }
+    }
+
+    private static boolean isOverlayButtonEnabled() {
+        if (!Settings.FLIP_VIDEO_BUTTON.get()) {
+            return false;
+        }
+        if (!Settings.FLIP_VIDEO_BUTTON_FULLSCREEN_ONLY.get()) {
+            return true;
+        }
+        PlayerType type = PlayerType.getCurrent();
+        return type == PlayerType.WATCH_WHILE_FULLSCREEN
+                || type == PlayerType.WATCH_WHILE_SLIDING_MAXIMIZED_FULLSCREEN;
+    }
+
+    private static void toggleFlip() {
+        try {
+            isFlipped = !isFlipped;
+            updateButtonIcon();
+            applyFlip();
+            Utils.showToastShort(str(isFlipped
+                    ? "morphe_flip_video_toast_on"
+                    : "morphe_flip_video_toast_off"));
+        } catch (Exception ex) {
+            Logger.printException(() -> "toggleFlip failure", ex);
+        }
+    }
+
+    public static void applyFlip() {
+        Utils.runOnMainThread(() -> {
+            try {
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+                        && SurfaceMirror.isSupported()) {
+                    SurfaceView videoSurface = resolveVideoSurface();
+                    if (videoSurface != null) {
+                        clearPlayerViewFlip();
+                        SurfaceMirror.apply(videoSurface, isFlipped);
+                        if (isFlipped) {
+                            attachMirrorListener();
+                        } else {
+                            detachMirrorListener();
+                        }
+                        return;
+                    }
+                }
+
+                detachMirrorListener();
+                applyPlayerViewFlip();
+            } catch (Exception ex) {
+                Logger.printException(() -> "applyFlip failure", ex);
+            }
+        });
+    }
+
+    /**
+     * Fallback for devices where the video surface cannot be transformed.
+     */
+    private static void applyPlayerViewFlip() {
+        View view = resolvePlayerView();
+        if (view == null) {
+            return;
+        }
+
+        final int w = view.getWidth();
+        final int h = view.getHeight();
+        if (w > 0 && h > 0) {
+            view.setPivotX(w / 2f);
+            view.setPivotY(h / 2f);
+        }
+        view.setScaleX(isFlipped ? -1.0f : 1.0f);
+        playerViewFlipped = isFlipped;
+    }
+
+    /**
+     * Removes the fallback player view flip, which would otherwise combine with the
+     * surface mirror on devices that reach both code paths.
+     */
+    private static void clearPlayerViewFlip() {
+        if (!playerViewFlipped) {
+            return;
+        }
+        playerViewFlipped = false;
+
+        View view = resolvePlayerView();
+        if (view != null) {
+            view.setScaleX(1.0f);
+        }
+    }
+
+    /**
+     * Keep the surface mirrored while flipped. YouTube restores the surface layer transform
+     * whenever the player view moves or is resized, and that transform is applied after this
+     * listener, so the mirror has to be put back on every frame.
+     */
+    private static void attachMirrorListener() {
+        View host = resolvePlayerView();
+        if (host == null) {
+            return;
+        }
+
+        if (mirrorListenerAttached && mirrorHostRef.get() == host) {
+            return;
+        }
+        detachMirrorListener();
+
+        ViewTreeObserver observer = host.getViewTreeObserver();
+        if (observer == null || !observer.isAlive()) {
+            return;
+        }
+
+        mirrorListener = () -> {
+            try {
+                SurfaceView videoSurface = resolveVideoSurface();
+                if (videoSurface != null) {
+                    SurfaceMirror.apply(videoSurface, isFlipped);
+                }
+            } catch (Exception ex) {
+                Logger.printException(() -> "FlipVideoButton mirror preDraw failure", ex);
+            }
+            return true;
+        };
+        observer.addOnPreDrawListener(mirrorListener);
+        mirrorHostRef = new WeakReference<>(host);
+        mirrorListenerAttached = true;
+    }
+
+    private static void detachMirrorListener() {
+        if (!mirrorListenerAttached) {
+            return;
+        }
+
+        ViewTreeObserver.OnPreDrawListener listener = mirrorListener;
+        View host = mirrorHostRef.get();
+        mirrorListener = null;
+        mirrorHostRef = new WeakReference<>(null);
+        mirrorListenerAttached = false;
+
+        if (host != null && listener != null) {
+            ViewTreeObserver observer = host.getViewTreeObserver();
+            if (observer != null && observer.isAlive()) {
+                observer.removeOnPreDrawListener(listener);
+            }
+        }
+    }
+
+    private static void updateButtonIcon() {
+        Utils.verifyOnMainThread();
+
+        final int icon = PlayerIcons.id(getIconBaseName());
+
+        ImageView overlayButton = overlayButtonRef.get();
+        if (overlayButton != null) {
+            overlayButton.setImageResource(icon);
+        }
+
+        if (legacy != null) {
+            legacy.setIcon(icon);
+        }
+    }
+
+    private static String getIconName() {
+        return PlayerIcons.name(getIconBaseName());
+    }
+
+    private static String getIconBaseName() {
+        return isFlipped
+                ? "morphe_flip_video_button_on"
+                : "morphe_flip_video_button_off";
+    }
+
+    @Nullable
+    private static View resolvePlayerView() {
+        View cached = playerViewRef.get();
+        if (cached != null && cached.isAttachedToWindow() && cached.getWidth() > 0) {
+            return cached;
+        }
+
+        Activity activity = Utils.getActivity();
+        if (activity != null) {
+            Window window = activity.getWindow();
+            if (window != null) {
+                View found = findPlayerView(window.getDecorView(), 0);
+                if (found != null) {
+                    playerViewRef = new WeakReference<>(found);
+                    return found;
+                }
+            }
+        }
+        return cached;
+    }
+
+    @Nullable
+    private static SurfaceView resolveVideoSurface() {
+        SurfaceView cached = videoSurfaceRef.get();
+        if (cached != null && isUsableVideoSurface(cached)) {
+            return cached;
+        }
+
+        View playerView = resolvePlayerView();
+        if (playerView != null) {
+            SurfaceView found = findVideoSurface(playerView, 0);
+            if (found != null) {
+                videoSurfaceRef = new WeakReference<>(found);
+                return found;
+            }
+        }
+        return cached != null && cached.isAttachedToWindow() ? cached : null;
+    }
+
+    private static boolean isUsableVideoSurface(SurfaceView surfaceView) {
+        return surfaceView.isAttachedToWindow()
+                && surfaceView.getVisibility() == View.VISIBLE
+                && surfaceView.getWidth() > 0;
+    }
+
+    @Nullable
+    private static View findPlayerView(View view, int depth) {
+        if (depth > 18 || view == null) {
+            return null;
+        }
+        String name = view.getClass().getName();
+        if (name.endsWith("YouTubePlayerViewNotForReflection")
+                || name.endsWith("player.ui.PlayerView")) {
+            return view;
+        }
+        if (!(view instanceof ViewGroup group)) {
+            return null;
+        }
+        for (int i = 0, n = group.getChildCount(); i < n; i++) {
+            View found = findPlayerView(group.getChildAt(i), depth + 1);
+            if (found != null) {
+                return found;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * Finds the video surface of the player. A player can keep several renderers around,
+     * so the largest visible one is used.
+     */
+    @Nullable
+    private static SurfaceView findVideoSurface(View view, int depth) {
+        if (depth > 24 || view == null) {
+            return null;
+        }
+        if (view instanceof SurfaceView surfaceView) {
+            return isUsableVideoSurface(surfaceView) ? surfaceView : null;
+        }
+        if (!(view instanceof ViewGroup group)) {
+            return null;
+        }
+
+        // A player can keep several renderers around, so prefer the largest visible one.
+        SurfaceView best = null;
+        long bestArea = -1;
+        for (int i = 0, n = group.getChildCount(); i < n; i++) {
+            SurfaceView found = findVideoSurface(group.getChildAt(i), depth + 1);
+            if (found != null) {
+                long area = (long) found.getWidth() * found.getHeight();
+                if (area > bestArea) {
+                    best = found;
+                    bestArea = area;
+                }
+            }
+        }
+        return best;
+    }
+
+    /**
+     * YouTube renders video into a SurfaceView, which SurfaceFlinger composites as its own
+     * layer. View transforms only update that layer's position and size with an unsigned
+     * scale, so the picture itself is never mirrored by them. Mirror the layer instead.
+     */
+    @RequiresApi(Build.VERSION_CODES.Q)
+    private static final class SurfaceMirror {
+
+        private static final SurfaceControl.Transaction TRANSACTION =
+                new SurfaceControl.Transaction();
+        private static final int[] LOCATION = new int[2];
+
+        @Nullable
+        private static Method setMatrixMethod;
+        private static boolean setMatrixResolved;
+        private static boolean failureLogged;
+
+        static boolean isSupported() {
+            return getSetMatrixMethod() != null;
+        }
+
+        static void apply(SurfaceView surfaceView, boolean flipped) {
+            if (!surfaceView.isAttachedToWindow()) {
+                return;
+            }
+
+            final int width = surfaceView.getWidth();
+            final int height = surfaceView.getHeight();
+            if (width <= 0 || height <= 0) {
+                return;
+            }
+
+            SurfaceControl surfaceControl = surfaceView.getSurfaceControl();
+            if (surfaceControl == null || !surfaceControl.isValid()) {
+                return;
+            }
+
+            Method setMatrix = getSetMatrixMethod();
+            if (setMatrix == null) {
+                return;
+            }
+
+            SurfaceHolder holder = surfaceView.getHolder();
+            Rect frame = holder != null ? holder.getSurfaceFrame() : null;
+            final float bufferWidth = frame != null && frame.width() > 0 ? frame.width() : width;
+            final float bufferHeight = frame != null && frame.height() > 0 ? frame.height() : height;
+
+            // The surface layer does not inherit view transforms, so include the scale
+            // applied by parent views (for example the fullscreen video scale patch).
+            float viewScaleX = 1f;
+            float viewScaleY = 1f;
+            for (ViewParent parent = surfaceView.getParent(); parent instanceof View; ) {
+                View view = (View) parent;
+                viewScaleX *= view.getScaleX();
+                viewScaleY *= view.getScaleY();
+                parent = view.getParent();
+            }
+
+            final float scaledWidth = width * viewScaleX;
+            final float scaledHeight = height * viewScaleY;
+
+            surfaceView.getLocationInWindow(LOCATION);
+
+            synchronized (TRANSACTION) {
+                try {
+                    // A layer matrix is the only way to mirror the surface. The public
+                    // setScale() rejects negative values, so use the (greylisted but
+                    // still accessible) matrix setter.
+                    setMatrix.invoke(TRANSACTION, surfaceControl,
+                            (flipped ? -scaledWidth : scaledWidth) / bufferWidth, 0f,
+                            0f, scaledHeight / bufferHeight);
+                    // Mirroring happens around the layer origin, so the mirrored content is
+                    // moved back into place by offsetting the position by the scaled width.
+                    TRANSACTION.setPosition(surfaceControl,
+                            flipped ? LOCATION[0] + Math.round(scaledWidth) : LOCATION[0],
+                            LOCATION[1]);
+                    TRANSACTION.apply();
+                } catch (ReflectiveOperationException | RuntimeException ex) {
+                    if (ex instanceof IllegalAccessException) {
+                        // Blocked by the hidden API policy, stop trying.
+                        setMatrixMethod = null;
+                    }
+                    if (!failureLogged) {
+                        failureLogged = true;
+                        Logger.printException(() -> "FlipVideoButton.SurfaceMirror failure", ex);
+                    }
+                }
+            }
+        }
+
+        @Nullable
+        private static Method getSetMatrixMethod() {
+            if (!setMatrixResolved) {
+                setMatrixResolved = true;
+                try {
+                    setMatrixMethod = SurfaceControl.Transaction.class.getMethod("setMatrix",
+                            SurfaceControl.class,
+                            float.class, float.class, float.class, float.class);
+                } catch (NoSuchMethodException ex) {
+                    Logger.printDebug(
+                            () -> "SurfaceControl.Transaction.setMatrix is not accessible", ex);
+                }
+            }
+            return setMatrixMethod;
+        }
+    }
+}
