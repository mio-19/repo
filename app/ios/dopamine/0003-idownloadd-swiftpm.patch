--- /dev/null
+++ b/BaseBin/idownloadd/Package.swift
@@ -0,0 +1,24 @@
+// swift-tools-version: 5.7
+import PackageDescription
+
+let package = Package(
+    name: "idownloadd",
+    platforms: [
+        .iOS(.v15),
+    ],
+    products: [
+        .executable(name: "idownloadd", targets: ["idownloadd"]),
+    ],
+    dependencies: [
+        .package(path: "iDownload"),
+    ],
+    targets: [
+        .executableTarget(
+            name: "idownloadd",
+            dependencies: ["iDownload"],
+            path: "src/idownloadd",
+            // SPM rejects mixed C/Swift in one target; shim.c is built by Make.
+            exclude: ["shim.c"]
+        ),
+    ]
+)
