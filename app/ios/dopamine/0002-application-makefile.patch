--- a/Application/Makefile
+++ b/Application/Makefile
@@ -1,4 +1,4 @@
-.PHONY: all clean build_clean
+.PHONY: all clean build_clean compile-assets
 
 all: Dopamine.ipa
 
@@ -15,13 +15,40 @@
 	rm -rf Dopamine.tipa
 	cp Dopamine.ipa Dopamine.tipa
 
+# Use -target (not -scheme) so xcodebuild does not require a resolved iOS
+# destination. Xcode 26 without iOS SDK installed errors on generic/platform=iOS.
+# Also avoids SPM network fetch for zstd (we link BaseBin's static libzstd).
+ZSTD_LIB = $(CURDIR)/../BaseBin/dopamine/external/lib/libzstd.a
+XCODE_FLAGS = -project Dopamine.xcodeproj -target Dopamine -configuration Debug \
+	-sdk iphoneos SYMROOT=$(CURDIR)/build/Build/Products OBJROOT=$(CURDIR)/build/Build/Intermediates.noindex \
+	CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO \
+	ENABLE_ON_DEMAND_RESOURCES=NO ENABLE_ONLY_ACTIVE_RESOURCES=YES BUILD_ACTIVE_RESOURCES_ONLY=YES \
+	OTHER_LDFLAGS="-force_load $(ZSTD_LIB)"
+
 ifeq ($(NIGHTLY), 1)
 build/Build/Products/Debug-iphoneos/Dopamine.app: FORCE
-	xcodebuild -scheme Dopamine -derivedDataPath build -destination 'generic/platform=iOS' CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO GCC_PREPROCESSOR_DEFINITIONS='NIGHTLY=1 COMMIT_HASH=\"$(COMMIT_HASH)\"'
+	xcodebuild $(XCODE_FLAGS) \
+		GCC_PREPROCESSOR_DEFINITIONS='NIGHTLY=1 COMMIT_HASH="$(COMMIT_HASH)"'
+	$(MAKE) compile-assets
 else
 build/Build/Products/Debug-iphoneos/Dopamine.app: FORCE
-	xcodebuild -scheme Dopamine -derivedDataPath build -destination 'generic/platform=iOS' CODE_SIGN_IDENTITY="" CODE_SIGNING_REQUIRED=NO
+	xcodebuild $(XCODE_FLAGS)
+	$(MAKE) compile-assets
 endif
+
+# Use Nixpkgs open-source actool reimplementation with our universal patch to compile assets,
+# generating both the .car and the loose PNGs required by TrollStore.
+compile-assets:
+	mkdir -p build/Build/Products/Debug-iphoneos/Dopamine.app
+	actool --compile build/Build/Products/Debug-iphoneos/Dopamine.app \
+		--platform iphoneos \
+		--minimum-deployment-target 15.0 \
+		--app-icon AppIcon \
+		--output-partial-info-plist build/Build/Products/Debug-iphoneos/actool_partial_info.plist \
+		Dopamine/Assets.xcassets
+	# Merge partial info.plist into the main one (Apple actool would do this via Xcode automatically)
+	plutil -insert CFBundleIcons -xml "$$(plutil -extract CFBundleIcons xml1 -o - build/Build/Products/Debug-iphoneos/actool_partial_info.plist)" build/Build/Products/Debug-iphoneos/Dopamine.app/Info.plist || true
+	plutil -insert CFBundleIcons~ipad -xml "$$(plutil -extract CFBundleIcons~ipad xml1 -o - build/Build/Products/Debug-iphoneos/actool_partial_info.plist)" build/Build/Products/Debug-iphoneos/Dopamine.app/Info.plist || true
 
 clean:
 	rm -rf build Payload Dopamine.ipa Dopamine.tipa
@@ -29,4 +56,4 @@
 build_clean:
 	rm -rf Payload build
 
-FORCE: ;
\ No newline at end of file
+FORCE: ;
