@@ -0,0 +1,88 @@
+package com.android.settings.sound;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.lifecycle.DefaultLifecycleObserver;
+import androidx.lifecycle.LifecycleOwner;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.TogglePreferenceController;
+
+public class EarProtectionHeadphonesOnlyPreferenceController extends TogglePreferenceController
+        implements DefaultLifecycleObserver {
+
+    private static final Uri ENABLED_URI = Settings.Global.getUriFor("volume_limiter_enabled");
+
+    private final ContentResolver mContentResolver;
+    private @Nullable Preference mPreference;
+
+    private final ContentObserver mObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange, @Nullable Uri uri) {
+                    if (mPreference != null) {
+                        updateState(mPreference);
+                    }
+                }
+            };
+
+    public EarProtectionHeadphonesOnlyPreferenceController(@NonNull Context context, @NonNull String key) {
+        super(context, key);
+        mContentResolver = context.getContentResolver();
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(@NonNull PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void onStart(@NonNull LifecycleOwner owner) {
+        mContentResolver.registerContentObserver(ENABLED_URI, false, mObserver);
+    }
+
+    @Override
+    public void onStop(@NonNull LifecycleOwner owner) {
+        mContentResolver.unregisterContentObserver(mObserver);
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Global.getInt(mContentResolver, "volume_limiter_headphones_only", 1) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        Settings.Global.putInt(mContentResolver,
+                "volume_limiter_headphones_only", isChecked ? 1 : 0);
+        return true;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        final boolean enabled = Settings.Global.getInt(mContentResolver,
+                "volume_limiter_enabled", 0) != 0;
+        preference.setEnabled(enabled);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return 0;
+    }
+}
