+    write /sys/module/exynos_drm/parameters/linear_matrix_application_threshold 600
+
+on property:persist.sys.komodo_high_emission_frequency_mode=five && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/freq_cmd 0x05,0x43,0x43,0x03
+    write /sys/module/panel_gs_cm4/parameters/freq_cmd 0x05,0x43,0x43,0x03
+    write /sys/module/exynos_drm/parameters/linear_matrix_application_threshold 600
+
+on property:persist.sys.komodo_high_emission_frequency_mode=six && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/freq_cmd 0x06,0x43,0x43,0x03
