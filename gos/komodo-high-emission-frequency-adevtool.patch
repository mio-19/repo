@@ -0,0 +1,6 @@
+prebuilt_etc {
+    name: "init.komodo.pwm.rc",
+    src: "init.komodo.pwm.rc",
+    sub_dir: "init",
+    vendor: true,
+}
diff -ruN a/config/mk/google_devices/device/komodo/conf/init.komodo.pwm.rc b/config/mk/google_devices/device/komodo/conf/init.komodo.pwm.rc
--- a/config/mk/google_devices/device/komodo/conf/init.komodo.pwm.rc	1970-01-01 10:00:00.000000000 +1000
+++ b/config/mk/google_devices/device/komodo/conf/init.komodo.pwm.rc	2026-11-08 22:44:49.418608391 +1100
@@ -0,0 +1,42 @@
+# One-byte PWM experiment. Never restore an experimental selection at boot.
+# Kernel pwm_mode defaults to -1 (stock), including before Android init runs.
+on early-boot
+    setprop sys.komodo_high_emission_frequency_mode off
+    write /sys/module/panel_gs_km4/parameters/pwm_mode -1
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode -1
+
+on property:sys.komodo_high_emission_frequency_mode=off && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode -1
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode -1
+
+on property:sys.komodo_high_emission_frequency_mode=zero && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 0
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 0
+
+on property:sys.komodo_high_emission_frequency_mode=one && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 1
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 1
+
+on property:sys.komodo_high_emission_frequency_mode=two && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 2
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 2
+
+on property:sys.komodo_high_emission_frequency_mode=three && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 3
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 3
+
+on property:sys.komodo_high_emission_frequency_mode=four && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 4
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 4
+
+on property:sys.komodo_high_emission_frequency_mode=five && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 5
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 5
+
+on property:sys.komodo_high_emission_frequency_mode=six && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 6
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 6
+
+on property:sys.komodo_high_emission_frequency_mode=seven && property:sys.boot_completed=1
+    write /sys/module/panel_gs_km4/parameters/pwm_mode 7
+    write /sys/module/panel_gs_cm4/parameters/pwm_mode 7
