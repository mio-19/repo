+                // leading zeros and the old 64-bit ones as decimal, so look up both.
+                serials.add(cert.getSerialNumber().toString(16));
+                serials.add(cert.getSerialNumber().toString());
+            } catch (Exception ignored) {}
+        }
+        return serials;
+    }
