+    private boolean checkTeeBroken() {
+        final String alias = "TrickyStoreTeeCheck";
+        KeyStore ks = null;
+        try {
+            ks = KeyStore.getInstance("AndroidKeyStore");
+            ks.load(null);
+            if (ks.containsAlias(alias)) ks.deleteEntry(alias);
