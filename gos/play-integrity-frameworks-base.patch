+    private boolean isCallerAllowedToAccessSpoof() {
+        final int callingUid = Binder.getCallingUid();
+        if (callingUid == Process.SYSTEM_UID
+                || callingUid == Process.PHONE_UID
+                || callingUid == Process.SHELL_UID
+                || callingUid == Process.ROOT_UID) {
+            return true;
+        }
+        if (mContext == null || mContext.getPackageManager() == null) {
+            return false;
+        }
+        final String[] packages = mContext.getPackageManager().getPackagesForUid(callingUid);
+        if (packages == null || packages.length == 0) {
+            return false;
+        }
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            String targets = android.provider.Settings.Secure.getString(
+                    mContext.getContentResolver(),
+                    android.provider.Settings.Secure.SPOOF_TRICKYSTORE_TARGET);
+            if (targets == null || targets.isEmpty()) {
+                targets = "com.google.android.gms\ncom.android.vending";
+            }
+            for (String pkg : packages) {
+                if (targets.contains(pkg)) {
+                    return true;
+                }
+            }
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+        return false;
+    }
