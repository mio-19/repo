+    private static boolean isHeadphoneDevice(int device) {
+        final int headphoneMask = AudioSystem.DEVICE_OUT_WIRED_HEADSET
+                | AudioSystem.DEVICE_OUT_WIRED_HEADPHONE
+                | AudioSystem.DEVICE_OUT_USB_HEADSET
+                | AudioSystem.DEVICE_OUT_USB_DEVICE
+                | AudioSystem.DEVICE_OUT_BLE_HEADSET
+                | AudioSystem.DEVICE_OUT_BLE_BROADCAST
+                | AudioSystem.DEVICE_OUT_BLUETOOTH_A2DP
+                | AudioSystem.DEVICE_OUT_BLUETOOTH_A2DP_HEADPHONES
+                | AudioSystem.DEVICE_OUT_HEARING_AID;
+        return (device & headphoneMask) != 0;
+    }
+
+    private boolean isVolumeLimiterActiveForDevice(int streamType, int device) {
+        if (!mVolumeLimiterEnabled) {
+            return false;
+        }
+        if (sStreamVolumeAlias.get(streamType, -1) != AudioSystem.STREAM_MUSIC
+                && streamType != AudioSystem.STREAM_MUSIC) {
+            return false;
+        }
+        if (mVolumeLimiterHeadphonesOnly && !isHeadphoneDevice(device)) {
+            return false;
+        }
+        return true;
+    }
+
+    private int getVolumeLimitIndex(int streamType) {
+        final VolumeStreamState vss = getVssForStreamOrDefault(streamType);
+        final int min = vss.getMinIndex();
+        final int max = vss.getMaxIndex();
+        final int percent = Math.max(10, Math.min(100, mVolumeLimiterValue));
+        int limit = min + (int) Math.round(((double) (max - min) * percent) / 100.0);
+        limit = ((limit + 5) / 10) * 10;
+        return Math.max(min, Math.min(max, limit));
+    }
+
+    private void updateVolumeLimiterSettings() {
+        mVolumeLimiterEnabled = mSettings.getGlobalInt(mContentResolver,
+                Settings.Global.VOLUME_LIMITER_ENABLED, 0) != 0;
+        mVolumeLimiterValue = mSettings.getGlobalInt(mContentResolver,
+                Settings.Global.VOLUME_LIMITER_VALUE, 70);
+        mVolumeLimiterHeadphonesOnly = mSettings.getGlobalInt(mContentResolver,
+                Settings.Global.VOLUME_LIMITER_HEADPHONES_ONLY, 1) != 0;
+        enforceVolumeLimit();
+    }
+
+    private void enforceVolumeLimit() {
+        if (!mVolumeLimiterEnabled) {
+            return;
+        }
+        final VolumeStreamState streamState = getVssForStream(AudioSystem.STREAM_MUSIC);
+        if (streamState == null) {
+            return;
+        }
+        final int limit = getVolumeLimitIndex(AudioSystem.STREAM_MUSIC);
+        synchronized (mSettingsLock) {
+            synchronized (mVolumeStateLock) {
+                for (int i = 0; i < streamState.mIndexMap.size(); i++) {
+                    int device = streamState.mIndexMap.keyAt(i);
+                    int index = streamState.mIndexMap.valueAt(i);
+                    if (isVolumeLimiterActiveForDevice(AudioSystem.STREAM_MUSIC, device)
+                            && index > limit) {
+                        streamState.setIndex(limit, device, TAG + ".enforceVolumeLimit", true);
+                        setDeviceVolume(streamState, device);
+                        sendVolumeUpdate(AudioSystem.STREAM_MUSIC, index, limit, 0, device);
+                    }
+                }
+                int currentDevice = getDeviceForStream(AudioSystem.STREAM_MUSIC);
+                int currentIndex = streamState.getIndex(currentDevice);
+                if (isVolumeLimiterActiveForDevice(AudioSystem.STREAM_MUSIC, currentDevice)
+                        && currentIndex > limit) {
+                    streamState.setIndex(limit, currentDevice, TAG + ".enforceVolumeLimit", true);
+                    setDeviceVolume(streamState, currentDevice);
+                    sendVolumeUpdate(AudioSystem.STREAM_MUSIC, currentIndex, limit, 0, currentDevice);
+                }
+            }
+        }
+    }
