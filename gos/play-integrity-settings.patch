+    private void showWipePlayStoreDialog() {
+        Context context = getContext();
+        if (context == null) return;
+
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.pi_wipe_playstore_confirm_title)
+                .setMessage(R.string.pi_wipe_playstore_confirm_message)
+                .setPositiveButton(R.string.okay, (dialog, which) -> doWipePlayStore())
