+    private void offerWipePlayStore() {
+        Context context = getContext();
+        if (context == null) return;
+
+        new AlertDialog.Builder(context)
+                .setTitle("Apply Changes to Play Store?")
+                .setMessage("Play Store caches integrity verdicts. Would you like to clear Play Store cache and restart Google Play Services now so changes take effect immediately?")
+                .setPositiveButton("Clear & Restart", (dialog, which) -> doWipePlayStore())
+                .setNegativeButton("Later", null)
+                .show();
+    }
+
+    private void doWipePlayStore() {
+        Context context = getContext();
+        if (context == null) return;
+
+        try {
+            ActivityManager am = context.getSystemService(ActivityManager.class);
+            if (am != null) {
+                am.forceStopPackage("com.google.android.gms");
+                am.forceStopPackage("com.android.vending");
+            }
+            context.getPackageManager().clearApplicationUserData("com.android.vending", null);
+            Toast.makeText(context, "Play Store cache cleared and Google services restarted", Toast.LENGTH_LONG).show();
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to clear Play Store data", e);
+            Toast.makeText(context, "Failed: " + e.getMessage(), Toast.LENGTH_SHORT).show();
+        }
+    }
