+
+public class PlayIntegritySettings extends SettingsPreferenceFragment {
+    private static final String TAG = "PlayIntegritySettings";
+
+    private static final String KEYBOX_KEY = "spoof_trickystore_keybox";
+    private static final String TARGET_KEY = "spoof_trickystore_target";
+    private static final String PATCH_KEY = "spoof_trickystore_patch";
+    private static final String PIF_KEY = "spoof_pif_values";
+
+    private static final String PREF_KEYBOX_STATUS = "pi_keybox_status";
+    private static final String PREF_IMPORT_KEYBOX = "pi_import_keybox";
+    private static final String PREF_DELETE_KEYBOX = "pi_delete_keybox";
+    private static final String PREF_TARGETS = "pi_targets";
+    private static final String PREF_RESET_TARGETS = "pi_reset_targets";
+    private static final String PREF_PATCH = "pi_patch";
+    private static final String PREF_PIF_STATUS = "pi_pif_status";
+    private static final String PREF_IMPORT_PIF = "pi_import_pif";
+    private static final String PREF_PRESET_PIF = "pi_preset_pif";
+    private static final String PREF_DELETE_PIF = "pi_delete_pif";
+    private static final String PREF_WIPE_PLAYSTORE = "pi_wipe_playstore";
+
+    private static final String DEFAULT_TARGETS =
+            "com.google.android.gms\n"
+            + "com.android.vending\n"
+            + "com.google.android.gsf\n"
+            + "com.google.android.apps.walletnfcrel";
+
+    private static final String PIXEL_6A_PROFILE =
+            "{\n"
+            + "  \"MANUFACTURER\": \"Google\",\n"
+            + "  \"MODEL\": \"Pixel 6a\",\n"
+            + "  \"FINGERPRINT\": \"google/bluejay/bluejay:13/TQ3A.230901.001/10750199:user/release-keys\",\n"
+            + "  \"BRAND\": \"google\",\n"
+            + "  \"PRODUCT\": \"bluejay\",\n"
+            + "  \"DEVICE\": \"bluejay\",\n"
+            + "  \"RELEASE\": \"13\",\n"
+            + "  \"ID\": \"TQ3A.230901.001\",\n"
+            + "  \"INCREMENTAL\": \"10750199\",\n"
+            + "  \"TYPE\": \"user\",\n"
+            + "  \"TAGS\": \"release-keys\",\n"
+            + "  \"SECURITY_PATCH\": \"2023-09-05\",\n"
+            + "  \"DEVICE_INITIAL_SDK_INT\": \"32\"\n"
+            + "}";
+
+    private static final String PIXEL_8_PROFILE =
+            "{\n"
+            + "  \"MANUFACTURER\": \"Google\",\n"
+            + "  \"MODEL\": \"Pixel 8\",\n"
+            + "  \"FINGERPRINT\": \"google/shiba/shiba:14/AP2A.240805.005/12028452:user/release-keys\",\n"
+            + "  \"BRAND\": \"google\",\n"
+            + "  \"PRODUCT\": \"shiba\",\n"
+            + "  \"DEVICE\": \"shiba\",\n"
+            + "  \"RELEASE\": \"14\",\n"
+            + "  \"ID\": \"AP2A.240805.005\",\n"
+            + "  \"INCREMENTAL\": \"12028452\",\n"
+            + "  \"TYPE\": \"user\",\n"
+            + "  \"TAGS\": \"release-keys\",\n"
+            + "  \"SECURITY_PATCH\": \"2024-08-05\",\n"
+            + "  \"DEVICE_INITIAL_SDK_INT\": \"34\"\n"
+            + "}";
+
+    private Preference mKeyboxStatusPref;
+    private Preference mImportKeyboxPref;
+    private Preference mDeleteKeyboxPref;
+    private Preference mTargetsPref;
+    private Preference mResetTargetsPref;
+    private Preference mPatchPref;
+    private Preference mPifStatusPref;
+    private Preference mImportPifPref;
+    private Preference mPresetPifPref;
+    private Preference mDeletePifPref;
+    private Preference mWipePlayStorePref;
+
+    private final ActivityResultLauncher<String> mKeyboxPicker =
+            registerForActivityResult(new ActivityResultContracts.GetContent(), this::onKeyboxFileSelected);
+
+    private final ActivityResultLauncher<String> mPifPicker =
+            registerForActivityResult(new ActivityResultContracts.GetContent(), this::onPifFileSelected);
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.PAGE_UNKNOWN;
+    }
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.play_integrity_settings);
+
+        mKeyboxStatusPref = findPreference(PREF_KEYBOX_STATUS);
+        mImportKeyboxPref = findPreference(PREF_IMPORT_KEYBOX);
+        mDeleteKeyboxPref = findPreference(PREF_DELETE_KEYBOX);
+        mTargetsPref = findPreference(PREF_TARGETS);
+        mResetTargetsPref = findPreference(PREF_RESET_TARGETS);
+        mPatchPref = findPreference(PREF_PATCH);
+        mPifStatusPref = findPreference(PREF_PIF_STATUS);
+        mImportPifPref = findPreference(PREF_IMPORT_PIF);
+        mPresetPifPref = findPreference(PREF_PRESET_PIF);
+        mDeletePifPref = findPreference(PREF_DELETE_PIF);
+        mWipePlayStorePref = findPreference(PREF_WIPE_PLAYSTORE);
+
+        if (mImportKeyboxPref != null) {
+            mImportKeyboxPref.setOnPreferenceClickListener(p -> {
+                mKeyboxPicker.launch("*/*");
+                return true;
+            });
+        }
+
+        if (mDeleteKeyboxPref != null) {
+            mDeleteKeyboxPref.setOnPreferenceClickListener(p -> {
+                showDeleteKeyboxDialog();
+                return true;
+            });
+        }
+
+        if (mTargetsPref != null) {
+            mTargetsPref.setOnPreferenceClickListener(p -> {
+                showTargetsEditDialog();
+                return true;
+            });
+        }
+
+        if (mResetTargetsPref != null) {
+            mResetTargetsPref.setOnPreferenceClickListener(p -> {
+                resetTargets();
+                return true;
+            });
+        }
+
+        if (mPatchPref != null) {
+            mPatchPref.setOnPreferenceClickListener(p -> {
+                showPatchEditDialog();
+                return true;
+            });
+        }
+
+        if (mImportPifPref != null) {
+            mImportPifPref.setOnPreferenceClickListener(p -> {
+                mPifPicker.launch("*/*");
+                return true;
+            });
+        }
+
+        if (mPresetPifPref != null) {
+            mPresetPifPref.setOnPreferenceClickListener(p -> {
+                showPresetPifDialog();
+                return true;
+            });
+        }
+
+        if (mDeletePifPref != null) {
+            mDeletePifPref.setOnPreferenceClickListener(p -> {
+                deletePif();
+                return true;
+            });
+        }
+
+        if (mWipePlayStorePref != null) {
+            mWipePlayStorePref.setOnPreferenceClickListener(p -> {
+                showWipePlayStoreDialog();
+                return true;
+            });
+        }
+
+        updateState();
+    }
+
+    private void updateState() {
+        ContentResolver cr = getContentResolver();
+        if (cr == null) return;
+
+        // Keybox status
+        String keyboxXml = Settings.Secure.getString(cr, KEYBOX_KEY);
+        if (TextUtils.isEmpty(keyboxXml)) {
+            if (mKeyboxStatusPref != null) {
+                mKeyboxStatusPref.setSummary(R.string.pi_no_keybox);
+            }
+            if (mDeleteKeyboxPref != null) {
+                mDeleteKeyboxPref.setEnabled(false);
+            }
+        } else {
+            String details = parseKeyboxDetails(keyboxXml);
+            if (mKeyboxStatusPref != null) {
+                mKeyboxStatusPref.setSummary(getString(R.string.pi_keybox_installed) + " (" + details + ")");
+            }
+            if (mDeleteKeyboxPref != null) {
+                mDeleteKeyboxPref.setEnabled(true);
+            }
+        }
+
+        // Target applications
+        String targets = Settings.Secure.getString(cr, TARGET_KEY);
+        if (targets == null) {
+            targets = DEFAULT_TARGETS;
+            Settings.Secure.putString(cr, TARGET_KEY, DEFAULT_TARGETS);
+        }
+        int count = countNonEmptyLines(targets);
+        if (mTargetsPref != null) {
+            mTargetsPref.setSummary(getString(R.string.pi_targets_count, count));
+        }
+
+        // Security patch
+        String patch = Settings.Secure.getString(cr, PATCH_KEY);
+        if (mPatchPref != null) {
+            if (TextUtils.isEmpty(patch)) {
+                mPatchPref.setSummary(R.string.pi_patch_default);
+            } else {
+                mPatchPref.setSummary(patch);
+            }
+        }
+
+        // PIF status
+        String pif = Settings.Secure.getString(cr, PIF_KEY);
+        if (TextUtils.isEmpty(pif)) {
+            if (mPifStatusPref != null) {
+                mPifStatusPref.setSummary(R.string.pi_no_pif);
+            }
+            if (mDeletePifPref != null) {
+                mDeletePifPref.setEnabled(false);
+            }
+        } else {
+            String pifSummary = parsePifDetails(pif);
+            if (mPifStatusPref != null) {
+                mPifStatusPref.setSummary(pifSummary);
+            }
+            if (mDeletePifPref != null) {
+                mDeletePifPref.setEnabled(true);
+            }
+        }
+    }
+
+    private String parsePifDetails(String pif) {
+        try {
+            if (pif.trim().startsWith("{")) {
+                JSONObject obj = new JSONObject(pif);
+                String model = obj.optString("MODEL", "Unknown");
+                String fp = obj.optString("FINGERPRINT", "");
+                if (fp.length() > 30) {
+                    fp = fp.substring(0, 27) + "...";
+                }
+                return model + " [" + fp + "]";
+            }
+        } catch (Exception ignored) {
+        }
+        return "Custom PIF config active";
+    }
+
+    private String parseKeyboxDetails(String xml) {
+        boolean hasEc = xml.contains("algorithm=\"ecdsa\"") || xml.contains("algorithm=\"ec\"");
+        boolean hasRsa = xml.contains("algorithm=\"rsa\"");
+        int certCount = 0;
+        Matcher m = Pattern.compile("<Certificate>").matcher(xml);
+        while (m.find()) certCount++;
+
+        StringBuilder sb = new StringBuilder();
+        if (hasEc && hasRsa) {
+            sb.append("EC + RSA");
+        } else if (hasEc) {
+            sb.append("EC only");
+        } else if (hasRsa) {
+            sb.append("RSA only");
+        } else {
+            sb.append("Keys detected");
+        }
+        if (certCount > 0) {
+            sb.append(", ").append(certCount).append(" certs");
+        }
+        return sb.toString();
+    }
+
+    private int countNonEmptyLines(String text) {
+        if (text == null) return 0;
+        int count = 0;
+        for (String line : text.split("\n")) {
+            if (!line.trim().isEmpty() && !line.trim().startsWith("#")) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    private void onKeyboxFileSelected(Uri uri) {
+        if (uri == null) return;
+        Context context = getContext();
+        if (context == null) return;
+
+        try (InputStream is = context.getContentResolver().openInputStream(uri);
+             BufferedReader reader = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                sb.append(line).append("\n");
+            }
+            String xmlContent = sb.toString().trim();
+            if (!xmlContent.contains("<Keybox") && !xmlContent.contains("<Key")) {
+                Toast.makeText(context, "Invalid keybox file format", Toast.LENGTH_LONG).show();
+                return;
+            }
+            Settings.Secure.putString(context.getContentResolver(), KEYBOX_KEY, xmlContent);
+            Toast.makeText(context, "Keybox imported successfully", Toast.LENGTH_SHORT).show();
+            updateState();
+            offerWipePlayStore();
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read keybox file", e);
+            Toast.makeText(context, "Failed to read file: " + e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void onPifFileSelected(Uri uri) {
+        if (uri == null) return;
+        Context context = getContext();
+        if (context == null) return;
+
+        try (InputStream is = context.getContentResolver().openInputStream(uri);
+             BufferedReader reader = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
+            StringBuilder sb = new StringBuilder();
+            String line;
+            while ((line = reader.readLine()) != null) {
+                sb.append(line).append("\n");
+            }
+            String content = sb.toString().trim();
+            if (content.isEmpty()) {
+                Toast.makeText(context, "Empty PIF file", Toast.LENGTH_LONG).show();
+                return;
+            }
+            Settings.Secure.putString(context.getContentResolver(), PIF_KEY, content);
+            Toast.makeText(context, "PIF profile imported successfully", Toast.LENGTH_SHORT).show();
+            updateState();
+            offerWipePlayStore();
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to read PIF file", e);
+            Toast.makeText(context, "Failed to read file: " + e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+    }
+
+    private void showDeleteKeyboxDialog() {
+        Context context = getContext();
+        if (context == null) return;
+
+        new AlertDialog.Builder(context)
+                .setTitle(R.string.pi_delete_keybox_dialog_title)
+                .setMessage(R.string.pi_delete_keybox_dialog_message)
+                .setPositiveButton(R.string.okay, (dialog, which) -> {
+                    Settings.Secure.putString(context.getContentResolver(), KEYBOX_KEY, "");
+                    Toast.makeText(context, "Keybox removed", Toast.LENGTH_SHORT).show();
+                    updateState();
+                    offerWipePlayStore();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void deletePif() {
+        Context context = getContext();
