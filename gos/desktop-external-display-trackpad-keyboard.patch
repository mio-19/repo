+    /**
+     * Manages the persistent notification offering virtual trackpad & keyboard input
+     * when connected to an external display in desktop mode.
+     * Reference: https://github.com/pgratz1/AR-Touchpad
+     */
+    private fun setupDesktopCompanionNotification() {
+        val notificationManager = context.getSystemService(NotificationManager::class.java) ?: return
+        val displayManager = context.getSystemService(DisplayManager::class.java) ?: return
+
+        val channel = NotificationChannel(
+            COMPANION_NOTIFICATION_CHANNEL_ID,
+            context.getString(R.string.desktop_companion_channel_name),
+            NotificationManager.IMPORTANCE_LOW
+        ).apply {
+            description = context.getString(R.string.desktop_companion_channel_desc)
+        }
+        notificationManager.createNotificationChannel(channel)
+
+        fun updateNotification() {
+            val isMirroring = secureSettings.getIntForUser(
+                MIRROR_BUILT_IN_DISPLAY,
+                0,
+                UserHandle.USER_CURRENT
+            ) != 0
+
+            val externalDisplay = displayManager.displays.firstOrNull {
+                it.displayId != DEFAULT_DISPLAY && it.type == Display.TYPE_EXTERNAL
+            }
+
+            if (externalDisplay != null && !isMirroring) {
+                val targetDisplayId = externalDisplay.displayId
+                val intent = Intent(context, TrackpadActivity::class.java).apply {
+                    putExtra(Intent.EXTRA_DISPLAY_ID, targetDisplayId)
+                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+                }
+                val pendingIntent = PendingIntent.getActivity(
+                    context,
+                    targetDisplayId,
+                    intent,
+                    PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+                )
+
+                val openAction = Notification.Action.Builder(
+                    null,
+                    context.getString(R.string.desktop_trackpad_open_action),
+                    pendingIntent
+                ).build()
+
+                val notification = Notification.Builder(context, COMPANION_NOTIFICATION_CHANNEL_ID)
+                    .setSmallIcon(R.drawable.ic_desktop_touchpad)
+                    .setContentTitle(context.getString(R.string.desktop_display_connected_title))
+                    .setContentText(context.getString(R.string.desktop_display_connected_text))
+                    .setContentIntent(pendingIntent)
+                    .addAction(openAction)
+                    .setOngoing(true)
+                    .setAutoCancel(false)
+                    .build()
+
+                notificationManager.notify(COMPANION_NOTIFICATION_ID, notification)
+            } else {
+                notificationManager.cancel(COMPANION_NOTIFICATION_ID)
+            }
+        }
+
+        displayManager.registerDisplayListener(
+            object : DisplayManager.DisplayListener {
+                override fun onDisplayAdded(displayId: Int) = updateNotification()
+                override fun onDisplayRemoved(displayId: Int) = updateNotification()
+                override fun onDisplayChanged(displayId: Int) = updateNotification()
+            },
+            null
+        )
+
+        secureSettings.observerFlow(UserHandle.USER_CURRENT, MIRROR_BUILT_IN_DISPLAY)
+            .onEach { updateNotification() }
+            .launchIn(scope)
